<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="@color/bookshelf_remove_confirm_end_pressed"
                android:startColor="@color/bookshelf_remove_confirm_start_pressed" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="@color/bookshelf_remove_confirm_end"
                android:startColor="@color/bookshelf_remove_confirm_start" />
            <corners android:radius="26dp" />
        </shape>
    </item>
</selector>
