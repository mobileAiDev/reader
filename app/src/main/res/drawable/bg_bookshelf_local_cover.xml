<?xml version="1.0" encoding="utf-8"?>
<!-- Text cover used while a cover loads, when it fails, and for local files: a quiet paper card. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@color/ink_cover_placeholder" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item
        android:bottom="6dp"
        android:left="6dp"
        android:right="6dp"
        android:top="6dp">
        <shape>
            <stroke
                android:width="0.5dp"
                android:color="@color/ink_cover_stroke" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item
        android:width="3dp"
        android:gravity="left">
        <shape>
            <solid android:color="@color/ink_cover_stroke" />
            <corners
                android:bottomLeftRadius="4dp"
                android:topLeftRadius="4dp" />
        </shape>
    </item>
</layer-list>
