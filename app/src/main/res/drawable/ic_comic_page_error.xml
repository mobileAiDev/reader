<?xml version="1.0" encoding="utf-8"?>
<!-- A page that failed: the same page-shaped slot with a faint retry mark. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="300dp"
        android:height="420dp">
        <shape>
            <solid android:color="#0DFFFFFF" />
        </shape>
    </item>
    <item
        android:width="36dp"
        android:height="36dp"
        android:drawable="@drawable/ic_comic_page_error_glyph"
        android:gravity="center" />
</layer-list>
