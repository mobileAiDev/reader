<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <LinearLayout
        android:id="@+id/home_shelf_summary"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="8dp">

        <TextView
            android:id="@+id/home_reading_time_chip"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/bg_home_reading_chip"
            android:clickable="true"
            android:drawableLeft="@drawable/ic_ink_schedule_16"
            android:drawableRight="@drawable/ic_ink_chevron_right_16"
            android:drawablePadding="6dp"
            android:drawableTint="@color/ink_text_tertiary"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingLeft="12dp"
            android:paddingRight="8dp"
            android:text="本周读0分钟"
            android:textColor="@color/ink_text_secondary"
            android:textSize="13sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/home_bookshelf_tools"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/home_bookshelf_filter"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:drawableLeft="@drawable/ic_ink_filter_16"
                android:drawablePadding="4dp"
                android:drawableTint="@color/ink_text_secondary"
                android:focusable="true"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="56dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="筛选"
                android:textColor="@color/ink_text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/home_bookshelf_edit"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="56dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="@string/bookshelf_edit"
                android:textColor="@color/ink_text_primary"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/home_bookshelf_content_frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.ldp.reader.widget.refresh.ScrollRefreshRecyclerView
            android:id="@+id/book_shelf_rv_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_scroll_empty="@layout/view_empty_book_shelf" />

        <LinearLayout
            android:id="@+id/home_bookshelf_filter_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="48dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingLeft="48dp"
            android:paddingRight="48dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_ink_circle_variant"
                android:contentDescription="@null"
                android:padding="18dp"
                android:src="@drawable/ic_ink_filter"
                app:tint="@color/ink_text_tertiary" />

            <TextView
                android:id="@+id/home_bookshelf_filter_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="当前筛选暂无书籍"
                android:textAppearance="@style/TextAppearance.Ink.Body"
                android:textColor="@color/ink_text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/home_bookshelf_filter_empty_reset"
                style="@style/Widget.Ink.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:minWidth="160dp"
                android:text="查看全部" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/home_bookshelf_audio_float"
            android:layout_width="264dp"
            android:layout_height="58dp"
            android:layout_gravity="right|bottom"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="@dimen/home_audio_float_bottom"
            android:background="@drawable/bg_audio_float"
            android:elevation="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="8dp"
            android:paddingRight="4dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/home_bookshelf_audio_cover"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_audio_disc"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_book_cover_placeholder" />

            <TextView
                android:id="@+id/home_bookshelf_audio_title"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/ink_toast_text"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/home_bookshelf_audio_play"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/bookshelf_audio_play_action"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_audio_legado_play_24"
                app:tint="@color/ink_toast_text" />

            <ImageButton
                android:id="@+id/home_bookshelf_audio_close"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/bookshelf_audio_close_action"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_ink_close"
                app:tint="@color/ink_toast_text" />
        </LinearLayout>
    </FrameLayout>

    </LinearLayout>

    <com.ldp.reader.ui.glass.GlassLinearLayout
        android:id="@+id/home_bookshelf_edit_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="@dimen/ink_float_bar_margin"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:visibility="gone"
        app:glassCorner="24dp"
        app:glassLook="bar">

        <TextView
            android:id="@+id/home_bookshelf_select_all"
            style="@style/Ink.EditBarAction"
            android:drawableTop="@drawable/ic_ink_select_all"
            android:text="@string/home_bookshelf_select_all" />

        <TextView
            android:id="@+id/home_bookshelf_pin_selected"
            style="@style/Ink.EditBarAction"
            android:alpha="0.38"
            android:drawableTop="@drawable/ic_ink_pin"
            android:enabled="false"
            android:text="@string/home_bookshelf_pin" />

        <TextView
            android:id="@+id/home_bookshelf_delete_selected"
            style="@style/Ink.EditBarAction"
            android:alpha="0.38"
            android:drawableTop="@drawable/ic_ink_delete"
            android:drawableTint="@color/ink_danger"
            android:enabled="false"
            android:text="@string/home_bookshelf_remove_zero"
            android:textColor="@color/ink_danger" />
    </com.ldp.reader.ui.glass.GlassLinearLayout>
</FrameLayout>
