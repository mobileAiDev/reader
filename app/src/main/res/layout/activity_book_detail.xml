<?xml version="1.0" encoding="utf-8"?>
<!--
  Book detail: the cover centred over a soft wash of its own colours (a blurred copy of it,
  Android 12 and later), the brief below, and the actions on a floating glass bar.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/book_detail_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/inkBg">

    <ImageView
        android:id="@+id/book_detail_ambient"
        android:layout_width="match_parent"
        android:layout_height="@dimen/book_detail_ambient_height"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/book_detail_ambient_height"
        android:background="@drawable/bg_book_detail_ambient_fade" />

    <LinearLayout
        android:id="@+id/book_detail_column"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/book_detail_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingLeft="4dp"
            android:paddingRight="4dp">

            <ImageView
                android:id="@+id/book_detail_nav_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/book_detail_navigate_back"
                android:focusable="true"
                android:padding="12dp"
                android:src="@drawable/ic_ink_back"
                app:tint="@color/ink_text_primary" />
        </LinearLayout>

        <com.ldp.reader.widget.RefreshLayout
            android:id="@+id/refresh_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:layout_refresh_loading="@layout/view_book_detail_skeleton">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/book_detail_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:overScrollMode="never">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingLeft="24dp"
                    android:paddingTop="8dp"
                    android:paddingRight="24dp"
                    android:paddingBottom="28dp">

                    <LinearLayout
                        android:id="@+id/book_detail_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/book_detail_iv_cover"
                            android:layout_width="@dimen/book_detail_cover_width"
                            android:layout_height="@dimen/book_detail_cover_height"
                            android:contentDescription="@null"
                            android:elevation="14dp"
                            android:outlineSpotShadowColor="@color/ink_glass_shadow"
                            android:padding="0.5dp"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Reader.BookCover"
                            app:strokeColor="@color/ink_cover_stroke"
                            app:strokeWidth="0.5dp" />

                        <LinearLayout
                            android:id="@+id/book_detail_info_panel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/book_detail_tv_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="?attr/inkTitleFont"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:letterSpacing="0.02"
                                android:lineSpacingExtra="4dp"
                                android:maxLines="2"
                                android:textColor="@color/ink_text_primary"
                                android:textSize="23sp"
                                android:textStyle="bold"
                                tools:text="武侠世界自由行" />

                            <TextView
                                android:id="@+id/book_detail_tv_author"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:textColor="@color/ink_text_secondary"
                                android:textSize="14sp"
                                tools:text="w风雪" />

                            <TextView
                                android:id="@+id/book_detail_tv_last_chapter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:background="@drawable/bg_ink_meta_pill"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:paddingLeft="12dp"
                                android:paddingTop="7dp"
                                android:paddingRight="12dp"
                                android:paddingBottom="7dp"
                                android:textColor="@color/ink_text_tertiary"
                                android:textSize="12sp"
                                tools:text="最新章节  第 100 章" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/book_detail_partial_refresh_error"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_search_book_progress_bar"
                        android:clickable="true"
                        android:drawableLeft="@drawable/ic_ink_refresh_16"
                        android:drawablePadding="8dp"
                        android:drawableTint="@color/ink_primary"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:includeFontPadding="false"
                        android:minHeight="48dp"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp"
                        android:text="@string/nb.book_detail.partial_refresh_error"
                        android:textColor="@color/ink_primary"
                        android:textSize="14sp"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="34dp"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.08"
                        android:text="@string/nb.book_detail.brief_title"
                        android:textColor="@color/ink_text_tertiary"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/book_detail_brief_panel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/book_detail_tv_brief"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:lineSpacingExtra="7dp"
                            android:maxLines="6"
                            android:textColor="@color/ink_text_secondary"
                            android:textSize="15sp"
                            tools:text="这里展示作品简介，点击后展开更多内容。" />

                        <TextView
                            android:id="@+id/book_detail_brief_toggle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:drawableRight="@drawable/ic_ink_expand_16"
                            android:drawablePadding="2dp"
                            android:drawableTint="@color/ink_text_primary"
                            android:includeFontPadding="false"
                            android:text="@string/book_detail_brief_expand"
                            android:textColor="@color/ink_text_primary"
                            android:textSize="13sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </com.ldp.reader.widget.RefreshLayout>
    </LinearLayout>

    <com.ldp.reader.ui.glass.GlassLinearLayout
        android:id="@+id/book_detail_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="@dimen/ink_float_bar_margin"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        app:glassLook="bar">

        <LinearLayout
            android:id="@+id/book_list_ll_chase"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginRight="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_book_detail_action_secondary"
            android:clickable="true"
            android:contentDescription="@string/nb.book_detail.chase_update"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/book_list_iv_chase"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginRight="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ink_add"
                app:tint="@color/ink_text_primary" />

            <TextView
                android:id="@+id/book_list_tv_chase"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:includeFontPadding="false"
                android:importantForAccessibility="no"
                android:text="@string/nb.book_detail.chase_update"
                android:textColor="@color/ink_text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/book_detail_tv_read"
            style="@style/Widget.Ink.Button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1.3"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/nb.book_detail.start_read" />
    </com.ldp.reader.ui.glass.GlassLinearLayout>
</FrameLayout>
