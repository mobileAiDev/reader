<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nb.read.bg_1">

    <!-- The page, with the progress in a footer band of its own so it never sits on a line of text. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <WebView
            android:id="@+id/epub_read_web"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/nb.read.bg_1" />

        <TextView
            android:id="@+id/epub_read_progress"
            android:layout_width="match_parent"
            android:layout_height="@dimen/reader_footer_height"
            android:layout_marginBottom="4dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="0%"
            android:textSize="12sp"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

    <TextView
        android:id="@+id/epub_read_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:accessibilityLiveRegion="polite"
        android:gravity="center"
        android:includeFontPadding="false"
        android:lineSpacingExtra="5dp"
        android:maxWidth="300dp"
        android:paddingLeft="24dp"
        android:paddingTop="18dp"
        android:paddingRight="24dp"
        android:paddingBottom="18dp"
        android:text="@string/epub_loading"
        android:textColor="@color/nb.read.font_1"
        android:textSize="15sp" />

    <!-- Floating glass bars, sprung in from the edges by FloatingBar. -->
    <com.ldp.reader.ui.glass.GlassFrameLayout
        android:id="@+id/epub_read_top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="top"
        android:layout_marginLeft="@dimen/reader_float_margin"
        android:layout_marginTop="@dimen/reader_float_margin"
        android:layout_marginRight="@dimen/reader_float_margin"
        android:clickable="true"
        android:elevation="10dp"
        android:visibility="invisible"
        app:glassCorner="22dp"
        app:glassLive="false"
        app:glassLook="bar"
        tools:visibility="visible">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/epub_read_toolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@android:color/transparent"
            android:theme="@style/Theme.ToolBar.Reader"
            app:contentInsetStart="0dp"
            app:contentInsetStartWithNavigation="0dp"
            tools:visibility="visible">

            <TextView
                android:id="@+id/epub_read_title"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/media_reader_text"
                android:textSize="17sp"
                tools:text="电子书.epub" />
        </androidx.appcompat.widget.Toolbar>
    </com.ldp.reader.ui.glass.GlassFrameLayout>

    <com.ldp.reader.ui.glass.GlassLinearLayout
        android:id="@+id/epub_read_bottom_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginLeft="@dimen/reader_float_margin"
        android:layout_marginRight="@dimen/reader_float_margin"
        android:layout_marginBottom="@dimen/reader_float_margin"
        android:clickable="true"
        android:elevation="10dp"
        android:orientation="vertical"
        android:paddingLeft="14dp"
        android:paddingTop="8dp"
        android:paddingRight="14dp"
        android:paddingBottom="10dp"
        android:visibility="invisible"
        app:glassCorner="26dp"
        app:glassLive="false"
        app:glassLook="bar"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/epub_read_font_panel"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/epub_read_font_size_label"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:minWidth="72dp"
                android:paddingRight="8dp"
                android:text="@string/reader_font_size"
                android:textColor="@color/media_reader_text_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/epub_read_decrease"
                android:layout_width="56dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_reader_panel_button"
                android:clickable="true"
                android:contentDescription="@string/epub_reader_decrease_font_size"
                android:focusable="true"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="A−"
                android:textColor="@color/media_reader_text"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/epub_read_font_size"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="100%"
                android:textColor="@color/media_reader_text_muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/epub_read_increase"
                android:layout_width="56dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_reader_panel_button"
                android:clickable="true"
                android:contentDescription="@string/epub_reader_increase_font_size"
                android:focusable="true"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="A+"
                android:textColor="@color/media_reader_text"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/epub_read_catalog"
                style="@style/MediaReaderPanelAction"
                android:drawableTop="@drawable/ic_ink_toc"
                android:contentDescription="打开 EPUB 目录"
                android:text="@string/reader_catalog" />

            <TextView
                android:id="@+id/epub_read_theme"
                style="@style/MediaReaderPanelAction"
                android:drawableTop="@drawable/ic_ink_contrast"
                android:contentDescription="切换 EPUB 阅读主题"
                android:text="@string/reader_theme" />

            <TextView
                android:id="@+id/epub_read_font"
                style="@style/MediaReaderPanelAction"
                android:drawableTop="@drawable/ic_ink_text_size"
                android:contentDescription="调整 EPUB 字体大小"
                android:text="@string/reader_font" />
        </LinearLayout>
    </com.ldp.reader.ui.glass.GlassLinearLayout>
</FrameLayout>
