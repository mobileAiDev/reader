<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F3EA"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/epub_read_toolbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#F7F3EA"
        android:theme="@style/Theme.ToolBar.Home"
        app:contentInsetStart="0dp"
        app:contentInsetStartWithNavigation="0dp">

        <TextView
            android:id="@+id/epub_read_title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#302820"
            android:textSize="17sp"
            tools:text="电子书.epub" />
    </androidx.appcompat.widget.Toolbar>

    <WebView
        android:id="@+id/epub_read_web"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:background="#EFE6D8"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingLeft="20dp"
        android:paddingRight="20dp">

        <TextView
            android:id="@+id/epub_read_decrease"
            android:layout_width="72dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_media_outline_button"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="A-"
            android:textColor="#302820"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/epub_read_font_size"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="100%"
            android:textColor="#6B5B49"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/epub_read_increase"
            android:layout_width="72dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_media_outline_button"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="A+"
            android:textColor="#302820"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
