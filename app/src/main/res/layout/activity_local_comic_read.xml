<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/media_reader_dark">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/local_comic_read_pages"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false" />

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/local_comic_read_toolbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_reader_top_bar"
        android:theme="@style/Theme.ToolBar.Home"
        android:visibility="gone"
        app:contentInsetStart="0dp"
        app:contentInsetStartWithNavigation="0dp"
        tools:visibility="visible">

        <TextView
            android:id="@+id/local_comic_read_title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/media_reader_text"
            android:textSize="17sp"
            tools:text="本地漫画.zip" />
    </androidx.appcompat.widget.Toolbar>

    <LinearLayout
        android:id="@+id/local_comic_read_bottom_panel"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_reader_bottom_bar"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/local_comic_read_direction"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_reader_panel_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:importantForAccessibility="yes"
            android:text="@string/local_comic_vertical_mode"
            android:textColor="@color/media_reader_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/local_comic_read_state"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:minWidth="72dp"
            android:textColor="@color/media_reader_text"
            android:textSize="14sp"
            tools:text="1 / 42" />
    </LinearLayout>

    <TextView
        android:id="@+id/local_comic_read_progress"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_reader_progress_pill"
        android:ellipsize="end"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxWidth="240dp"
        android:minWidth="74dp"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:singleLine="true"
        android:textColor="@color/media_reader_text"
        android:textSize="12sp"
        tools:text="1 / 42" />

    <TextView
        android:id="@+id/local_comic_read_page_retry"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_comic_action_primary"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:importantForAccessibility="yes"
        android:minWidth="168dp"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:textColor="@color/home_text_on_primary"
        android:textSize="15sp"
        android:visibility="gone"
        tools:text="当前图片无法显示，点击重试"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/local_comic_read_error"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/media_reader_dark"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingLeft="32dp"
        android:paddingRight="32dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:text="@string/local_comic_open_failed"
            android:textColor="@color/media_reader_text"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/local_comic_read_error_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:maxLines="6"
            android:textColor="@color/media_reader_text_muted"
            android:textSize="14sp"
            tools:text="漫画压缩包损坏或没有可读取的图片" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/local_comic_read_error_back"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_media_outline_button"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="@string/local_comic_back"
                android:textColor="@color/media_reader_text"
                android:textSize="15sp" />

            <Button
                android:id="@+id/local_comic_read_retry"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="12dp"
                android:layout_weight="1"
                android:background="@drawable/bg_comic_action_primary"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="@string/local_comic_retry"
                android:textColor="@color/home_text_on_primary"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
