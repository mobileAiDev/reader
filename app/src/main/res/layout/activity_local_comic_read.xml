<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/media_reader_dark">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/local_comic_read_pages"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="64dp"
        android:paddingBottom="42dp" />

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/local_comic_read_toolbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_reader_top_bar"
        android:theme="@style/Theme.ToolBar.Home"
        app:contentInsetStart="0dp"
        app:contentInsetStartWithNavigation="0dp">

        <TextView
            android:id="@+id/local_comic_read_title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/media_reader_text"
            android:textSize="17sp"
            tools:text="本地漫画.zip" />
    </androidx.appcompat.widget.Toolbar>

    <TextView
        android:id="@+id/local_comic_read_state"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_reader_bottom_bar"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="@color/media_reader_text_muted"
        android:textSize="13sp"
        tools:text="1 / 42" />
</FrameLayout>
