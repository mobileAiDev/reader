<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/login_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/inkBg">

    <ScrollView
        android:id="@+id/login_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingLeft="24dp"
        android:paddingTop="72dp"
        android:paddingRight="24dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_ink_logo" />

            <TextView
                android:id="@+id/login_header_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:ellipsize="end"
                android:fontFamily="?attr/inkTitleFont"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="登录墨舟"
                android:textAppearance="@style/TextAppearance.Ink.Display" />

            <TextView
                android:id="@+id/login_header_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:includeFontPadding="false"
                android:text="同步书架、阅读进度和最近章节"
                android:textAppearance="@style/TextAppearance.Ink.BodySmall" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp">

                <LinearLayout
                    android:id="@+id/ll_user_not_login"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/login_form_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="手机号登录"
                        android:textAppearance="@style/TextAppearance.Ink.Title" />

                    <TextView
                        android:id="@+id/login_form_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:includeFontPadding="false"
                        android:text="使用验证码登录后自动同步当前书架"
                        android:textAppearance="@style/TextAppearance.Ink.Caption" />

                    <LinearLayout
                        android:id="@+id/login_phone_row"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_login_input"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingLeft="16dp"
                        android:paddingRight="6dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_ink_phone"
                            app:tint="@color/ink_text_tertiary" />

                        <EditText
                            android:id="@+id/et_user_phone"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginLeft="12dp"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="手机号码"
                            android:inputType="phone"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:textColor="@color/ink_text_primary"
                            android:textColorHint="@color/ink_text_tertiary"
                            android:textSize="15sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_get_sms_code"
                            style="@style/Widget.Ink.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:minWidth="96dp"
                            android:text="获取验证码"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/login_code_row"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_login_input"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_ink_lock"
                            app:tint="@color/ink_text_tertiary" />

                        <EditText
                            android:id="@+id/et_sms_code_input"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginLeft="12dp"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="验证码"
                            android:inputType="number"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:textColor="@color/ink_text_primary"
                            android:textColorHint="@color/ink_text_tertiary"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_user_login"
                        style="@style/Widget.Ink.Button"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="28dp"
                        android:text="登录" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_direct_login"
                        style="@style/Widget.Ink.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="12dp"
                        android:text="本机号码一键登录" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_user_login"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_ink_card"
                    android:clipToOutline="true"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingLeft="20dp"
                    android:paddingTop="32dp"
                    android:paddingRight="20dp"
                    android:paddingBottom="24dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:id="@+id/iv_user_logo"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/bg_mine_avatar"
                        android:contentDescription="@null"
                        android:padding="18dp"
                        android:src="@drawable/ic_ink_person_filled"
                        app:tint="@color/ink_primary" />

                    <TextView
                        android:id="@+id/login_state_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:includeFontPadding="false"
                        android:text="已登录"
                        android:textAppearance="@style/TextAppearance.Ink.Headline" />

                    <TextView
                        android:id="@+id/tv_user_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:includeFontPadding="false"
                        android:textAppearance="@style/TextAppearance.Ink.BodySmall"
                        tools:text="reader_user" />

                    <TextView
                        android:id="@+id/login_state_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:text="书架和阅读进度会随账号同步"
                        android:textAppearance="@style/TextAppearance.Ink.Caption" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_user_logout"
                        style="@style/Widget.Ink.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="28dp"
                        android:text="退出登录"
                        android:textColor="@color/ink_danger" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </ScrollView>

    <ImageView
        android:id="@+id/iv_login_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/login_close"
        android:padding="12dp"
        android:src="@drawable/ic_ink_close"
        app:tint="@color/ink_text_primary" />
</FrameLayout>
