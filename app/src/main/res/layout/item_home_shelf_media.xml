<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="6dp"
    android:paddingBottom="18dp"
    android:background="@drawable/selector_home_book_card_long_press"
    android:clipChildren="false"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <com.ldp.reader.ui.widget.CoverFrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/home_shelf_media_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/inkCoverPlaceholder"
            android:scaleType="centerCrop"
            tools:src="@drawable/ic_book_cover_placeholder" />

        <!-- What kind of book this is, as a quiet label like the other cover badges. -->
        <TextView
            android:id="@+id/home_shelf_media_badge"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_gravity="left|top"
            android:layout_margin="6dp"
            android:background="@drawable/bg_ink_badge_scrim"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:textColor="@color/white"
            android:textSize="10sp"
            tools:text="漫画" />

        <CheckBox
            android:id="@+id/home_shelf_media_selected"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="right|top"
            android:layout_marginRight="6dp"
            android:layout_marginTop="6dp"
            android:background="@android:color/transparent"
            android:button="@drawable/selector_bookshelf_edit_check"
            android:clickable="false"
            android:focusable="false"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:visibility="gone"
            tools:visibility="visible" />
    </com.ldp.reader.ui.widget.CoverFrameLayout>

    <!-- Title and progress under the cover; themes with real shelves hide them. -->
    <LinearLayout
        android:id="@+id/home_shelf_media_captions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/home_shelf_media_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:textColor="@color/ink_text_primary"
            android:textSize="14sp"
            tools:text="吞噬星空" />

        <TextView
            android:id="@+id/home_shelf_media_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/ink_text_tertiary"
            android:textSize="12sp"
            tools:text="第12话 · 第11页" />
    </LinearLayout>
</LinearLayout>
