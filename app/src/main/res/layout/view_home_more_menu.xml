<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_menu_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.activity.MainActivity">

    <View
        android:id="@+id/home_menu_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent" />

    <com.ldp.reader.ui.glass.GlassLinearLayout
        android:id="@+id/home_menu_popup"
        android:layout_width="196dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|right"
        android:layout_marginTop="60dp"
        android:layout_marginRight="12dp"
        android:elevation="16dp"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        app:glassCorner="20dp"
        app:glassLook="popup">

        <LinearLayout
            android:id="@+id/home_menu_import"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_ink_menu_row"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:paddingRight="20dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_ink_import"
                app:tint="@color/ink_text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:maxWidth="120dp"
                android:text="@string/nb.menu.action.scan"
                android:textColor="@color/ink_text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/home_menu_import_source"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_ink_menu_row"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:paddingRight="20dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_ink_source"
                app:tint="@color/ink_text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:maxWidth="120dp"
                android:text="@string/nb.menu.action.import_source"
                android:textColor="@color/ink_text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/home_menu_sync"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_ink_menu_row"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:paddingRight="20dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_ink_sync"
                app:tint="@color/ink_text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:maxWidth="120dp"
                android:text="@string/nb.menu.action.sync"
                android:textColor="@color/ink_text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="4dp"
            android:background="?attr/inkDivider" />

        <LinearLayout
            android:id="@+id/home_menu_account"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_ink_menu_row"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:paddingRight="20dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_ink_person"
                app:tint="@color/ink_text_secondary" />

            <TextView
                android:id="@+id/home_menu_account_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:maxWidth="120dp"
                android:text="@string/nb.menu.action.login"
                android:textColor="@color/ink_text_primary"
                android:textSize="15sp" />
        </LinearLayout>
    </com.ldp.reader.ui.glass.GlassLinearLayout>
</FrameLayout>
