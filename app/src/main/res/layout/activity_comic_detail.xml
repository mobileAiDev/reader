<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/media_bg"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/comic_detail_toolbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/media_surface"
        android:paddingRight="12dp"
        android:theme="@style/Theme.ToolBar.Home"
        app:contentInsetStart="0dp"
        app:contentInsetStartWithNavigation="0dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="漫画"
            android:textColor="@color/media_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />
    </androidx.appcompat.widget.Toolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_media_panel"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/comic_detail_cover"
                        android:layout_width="108dp"
                        android:layout_height="144dp"
                        android:background="@drawable/bg_media_cover"
                        android:scaleType="centerCrop" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/comic_detail_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:maxLines="3"
                            android:textColor="@color/media_text_primary"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            tools:text="火影忍者" />

                        <TextView
                            android:id="@+id/comic_detail_meta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:ellipsize="end"
                            android:lineSpacingExtra="3dp"
                            android:maxLines="3"
                            android:textColor="@color/media_text_secondary"
                            android:textSize="14sp"
                            tools:text="岸本齐史 | 更新至第700话" />

                        <TextView
                            android:id="@+id/comic_detail_state"
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_media_chip"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:paddingLeft="12dp"
                            android:paddingRight="12dp"
                            android:textColor="@color/media_comic_accent"
                            android:textSize="13sp"
                            tools:text="加载中" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/comic_detail_add_shelf"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_media_outline_button"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:text="加入书架"
                        android:textColor="@color/media_comic_accent"
                        android:textSize="15sp" />

                    <Button
                        android:id="@+id/comic_detail_start"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginLeft="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_comic_action_primary"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:text="开始阅读"
                        android:textColor="@color/home_text_on_primary"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/comic_detail_latest"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginLeft="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_comic_action_primary"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:text="最新一话"
                        android:textColor="@color/home_text_on_primary"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:includeFontPadding="false"
                android:text="简介"
                android:textColor="@color/media_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/comic_detail_intro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_media_panel"
                android:ellipsize="end"
                android:lineSpacingExtra="5dp"
                android:maxLines="6"
                android:padding="14dp"
                android:textColor="@color/media_text_secondary"
                android:textSize="14sp"
                tools:text="忍者世界的少年冒险故事。" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/comic_detail_chapter_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:includeFontPadding="false"
                    android:text="章节"
                    android:textColor="@color/media_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/comic_detail_chapter_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="@color/media_text_tertiary"
                    android:textSize="13sp"
                    tools:text="120 话" />

                <TextView
                    android:id="@+id/comic_detail_catalog_all"
                    android:layout_width="76dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="全部目录"
                    android:textColor="@color/media_text_primary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/comic_detail_order"
                    android:layout_width="56dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="倒序"
                    android:textColor="@color/media_comic_accent"
                    android:textSize="14sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/comic_detail_chapters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                    android:nestedScrollingEnabled="false" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
