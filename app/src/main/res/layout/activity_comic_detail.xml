<?xml version="1.0" encoding="utf-8"?>
<!--
  Comic detail, laid out like the book detail page: the cover centred over a soft wash of its own
  colours, the brief and the first chapters below, and the actions on a floating glass bar.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/inkBg">

    <ImageView
        android:id="@+id/comic_detail_ambient"
        android:layout_width="match_parent"
        android:layout_height="@dimen/book_detail_ambient_height"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/book_detail_ambient_height"
        android:background="@drawable/bg_book_detail_ambient_fade" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/comic_detail_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:minHeight="56dp"
            android:theme="@style/Theme.ToolBar.Home"
            app:contentInsetStart="0dp"
            app:contentInsetStartWithNavigation="0dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.ldp.reader.ui.widget.TopFadingScrollView
                android:id="@+id/comic_detail_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fadingEdgeLength="24dp"
                android:overScrollMode="never"
                android:requiresFadingEdge="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingLeft="24dp"
                    android:paddingTop="8dp"
                    android:paddingRight="24dp"
                    android:paddingBottom="28dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/comic_detail_cover"
                            android:layout_width="@dimen/book_detail_cover_width"
                            android:layout_height="@dimen/book_detail_cover_height"
                            android:background="?attr/inkCoverPlaceholder"
                            android:contentDescription="@null"
                            android:elevation="14dp"
                            android:outlineSpotShadowColor="@color/ink_glass_shadow"
                            android:padding="0.5dp"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Reader.BookCover"
                            app:strokeColor="@color/ink_cover_stroke"
                            app:strokeWidth="0.5dp" />

                        <TextView
                            android:id="@+id/comic_detail_title"
                            style="@style/Ink.MediaDetail.Title"
                            tools:text="斗罗大陆" />

                        <TextView
                            android:id="@+id/comic_detail_meta"
                            style="@style/Ink.MediaDetail.Meta"
                            tools:text="风炫动漫" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/comic_detail_state"
                                style="@style/Ink.MediaDetail.Pill"
                                tools:text="共 996 话" />

                            <TextView
                                android:id="@+id/comic_detail_latest"
                                style="@style/Ink.MediaDetail.Pill.Action"
                                android:layout_marginLeft="8dp"
                                tools:text="最新 · 第344话 复活仪式开始" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        style="@style/Ink.MediaDetail.SectionLabel"
                        android:text="@string/nb.book_detail.brief_title" />

                    <TextView
                        android:id="@+id/comic_detail_intro"
                        style="@style/Ink.MediaDetail.Intro"
                        tools:text="偷学一身绝世功夫，最后却选择了跳崖明志……" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="26dp"
                        android:gravity="center_vertical"
                        android:minHeight="40dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/comic_detail_chapter_title"
                            style="@style/Ink.MediaDetail.SectionLabel.Inline"
                            android:text="@string/media_detail_chapters" />

                        <TextView
                            android:id="@+id/comic_detail_chapter_hint"
                            style="@style/Ink.MediaDetail.SectionHint"
                            tools:text="共 996 话" />

                        <TextView
                            android:id="@+id/comic_detail_order"
                            style="@style/Ink.MediaDetail.SectionAction"
                            android:text="倒序" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/comic_detail_chapters"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                    <TextView
                        android:id="@+id/comic_detail_catalog_all"
                        style="@style/Ink.MediaDetail.AllChapters"
                        android:text="@string/media_detail_all_chapters" />
                </LinearLayout>
            </com.ldp.reader.ui.widget.TopFadingScrollView>

            <!-- Loading: the outline of the page breathing in place, with the current step beneath. -->
            <LinearLayout
                android:id="@+id/comic_detail_loading_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/inkBg"
                android:clickable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="visible">

                <include
                    layout="@layout/view_book_detail_skeleton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/comic_detail_loading_title"
                    style="@style/Ink.MediaDetail.LoadingTitle"
                    android:text="正在加载" />

                <TextView
                    android:id="@+id/comic_detail_loading_step"
                    style="@style/Ink.MediaDetail.LoadingStep"
                    android:text="正在加载作品信息" />

                <ProgressBar
                    android:id="@+id/comic_detail_loading_progress"
                    style="@style/Ink.MediaDetail.LoadingProgress"
                    android:indeterminate="true" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/comic_detail_loading_retry"
                    style="@style/Widget.Ink.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="20dp"
                    android:minWidth="160dp"
                    android:text="重新加载"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <com.ldp.reader.ui.glass.GlassLinearLayout
        android:id="@+id/comic_detail_bottom_bar"
        style="@style/Ink.MediaDetail.ActionBar"
        app:glassLook="bar">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/comic_detail_add_shelf"
            style="@style/Ink.MediaDetail.SecondaryAction"
            android:text="加入书架"
            app:icon="@drawable/ic_ink_add" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/comic_detail_start"
            style="@style/Ink.MediaDetail.PrimaryAction"
            android:text="开始阅读" />
    </com.ldp.reader.ui.glass.GlassLinearLayout>
</FrameLayout>
