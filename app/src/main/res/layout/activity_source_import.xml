<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/inkBg"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/source_import_toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/inkBg"
        android:theme="@style/Theme.ToolBar.Home"
        app:contentInsetStart="0dp"
        app:contentInsetStartWithNavigation="0dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/source_import_title"
            android:textAppearance="@style/TextAppearance.Ink.Toolbar" />
    </androidx.appcompat.widget.Toolbar>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingTop="8dp"
            android:paddingRight="16dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ink_card"
                android:clipToOutline="true"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableLeft="@drawable/ic_ink_source"
                    android:drawablePadding="10dp"
                    android:drawableTint="@color/ink_primary"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:text="从地址导入"
                    android:textAppearance="@style/TextAppearance.Ink.Title" />

                <EditText
                    android:id="@+id/source_import_url_input"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_ink_input"
                    android:hint="@string/source_import_address_hint"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:singleLine="true"
                    android:textColor="@color/ink_text_primary"
                    android:textColorHint="@color/ink_text_tertiary"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/source_import_url_button"
                    style="@style/Widget.Ink.Button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="导入" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/source_import_file_button"
                style="@style/Widget.Ink.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:text="选择书源文件"
                app:icon="@drawable/ic_ink_file"
                app:iconGravity="textStart"
                app:iconSize="18dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_ink_card"
                android:clipToOutline="true"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableLeft="@drawable/ic_ink_edit"
                    android:drawablePadding="10dp"
                    android:drawableTint="@color/ink_primary"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:text="粘贴书源内容"
                    android:textAppearance="@style/TextAppearance.Ink.Title" />

                <EditText
                    android:id="@+id/source_import_json_input"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_ink_input"
                    android:gravity="top"
                    android:hint="粘贴书源内容"
                    android:inputType="textMultiLine"
                    android:padding="14dp"
                    android:textColor="@color/ink_text_primary"
                    android:textColorHint="@color/ink_text_tertiary"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/source_import_json_button"
                    style="@style/Widget.Ink.Button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="导入书源内容" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/source_import_progress"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:indeterminateTint="@color/ink_primary"
                android:visibility="gone" />

            <TextView
                android:id="@+id/source_import_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_media_import_panel"
                android:lineSpacingExtra="3dp"
                android:padding="14dp"
                android:textColor="@color/ink_text_secondary"
                android:textSize="13sp"
                tools:text="等待导入" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
