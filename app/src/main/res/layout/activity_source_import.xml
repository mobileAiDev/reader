<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/media_bg"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/source_import_toolbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/media_surface"
        android:paddingRight="12dp"
        android:theme="@style/Theme.ToolBar.Home"
        app:contentInsetStart="0dp"
        app:contentInsetStartWithNavigation="0dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/source_import_title"
            android:textColor="@color/media_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />
    </androidx.appcompat.widget.Toolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_media_panel"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="从地址导入"
                    android:textColor="@color/media_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/source_import_url_input"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_login_input"
                    android:hint="https://..."
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:textColor="@color/media_text_primary"
                    android:textColorHint="@color/media_text_tertiary"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/source_import_url_button"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_audio_action_primary"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:text="导入"
                    android:textColor="@color/home_text_on_primary"
                    android:textSize="16sp" />
            </LinearLayout>

            <Button
                android:id="@+id/source_import_file_button"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_media_outline_button"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="选择本地 JSON"
                android:textColor="@color/media_audio_accent"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_media_panel"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="粘贴内容"
                    android:textColor="@color/media_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/source_import_json_input"
                    android:layout_width="match_parent"
                    android:layout_height="170dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_login_input"
                    android:gravity="top"
                    android:hint="粘贴 JSON"
                    android:inputType="textMultiLine"
                    android:padding="14dp"
                    android:textColor="@color/media_text_primary"
                    android:textColorHint="@color/media_text_tertiary"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/source_import_json_button"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_audio_action_primary"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:text="导入粘贴内容"
                    android:textColor="@color/home_text_on_primary"
                    android:textSize="16sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/source_import_progress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="18dp" />

            <TextView
                android:id="@+id/source_import_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_media_import_panel"
                android:lineSpacingExtra="4dp"
                android:padding="16dp"
                android:textColor="@color/media_text_secondary"
                android:textSize="14sp"
                tools:text="等待导入" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
