<?xml version="1.0" encoding="utf-8"?>
<!-- Reader chrome colours are applied at runtime from ReaderPalette so they follow the page. -->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/read_dl_slide"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/read_page_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/nb.read.bg_1">

        <com.ldp.reader.widget.page.PageView
            android:id="@+id/read_pv_page"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:importantForAccessibility="yes"
            tools:visibility="gone" />

        <com.ldp.reader.ui.glass.GlassFrameLayout
            android:id="@+id/read_page_tip"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_above="@+id/read_bottom_menu"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="10dp"
            android:elevation="8dp"
            android:visibility="invisible"
            app:glassLook="popup">

            <TextView
                android:id="@+id/read_tv_page_tip"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:ellipsize="middle"
                android:fontFeatureSettings="tnum"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxWidth="260dp"
                android:minWidth="88dp"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:singleLine="true"
                android:text="1/12"
                android:textSize="13sp" />
        </com.ldp.reader.ui.glass.GlassFrameLayout>

        <!-- Floating glass bars; ReadActivity springs them in from the edges. -->
        <com.ldp.reader.ui.glass.GlassFrameLayout
            android:id="@+id/read_top_menu"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_alignParentTop="true"
            android:layout_marginLeft="@dimen/reader_float_margin"
            android:layout_marginTop="@dimen/reader_float_margin"
            android:layout_marginRight="@dimen/reader_float_margin"
            android:clickable="true"
            android:elevation="10dp"
            android:visibility="invisible"
            app:glassCorner="22dp"
            app:glassLook="bar"
            tools:visibility="visible">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@android:color/transparent"
                android:minHeight="56dp"
                app:contentInsetStartWithNavigation="0dp"
                app:navigationContentDescription="@string/reader_navigate_back"
                app:navigationIcon="@drawable/ic_ink_back"
                app:subtitleTextAppearance="@style/TextAppearance.Ink.ReaderBarSubtitle"
                app:titleTextAppearance="@style/TextAppearance.Ink.ReaderBarTitle">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="right"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingRight="4dp">

                    <ImageView
                        android:id="@+id/tv_change_source"
                        style="@style/Ink.IconButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="13dp"
                        android:contentDescription="@string/reader_refresh_chapter"
                        android:src="@drawable/ic_ink_refresh" />

                    <ImageView
                        android:id="@+id/read_tv_brief"
                        style="@style/Ink.IconButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="13dp"
                        android:contentDescription="@string/nb.read.brief"
                        android:src="@drawable/ic_ink_info" />
                </LinearLayout>
            </androidx.appcompat.widget.Toolbar>
        </com.ldp.reader.ui.glass.GlassFrameLayout>

        <com.ldp.reader.ui.glass.GlassLinearLayout
            android:id="@+id/read_bottom_menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginLeft="@dimen/reader_float_margin"
            android:layout_marginRight="@dimen/reader_float_margin"
            android:layout_marginBottom="@dimen/reader_float_margin"
            android:clickable="true"
            android:elevation="10dp"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:visibility="invisible"
            app:glassCorner="26dp"
            app:glassLook="bar"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="4dp"
                android:paddingRight="4dp">

                <TextView
                    android:id="@+id/read_tv_pre_chapter"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:minWidth="68dp"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:text="上一章"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/read_sb_chapter_progress"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:maxHeight="3dp"
                    android:minHeight="3dp"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:progressDrawable="@drawable/seekbar_bg"
                    android:splitTrack="false"
                    android:thumb="@drawable/seekbar_thumb_reader" />

                <TextView
                    android:id="@+id/read_tv_next_chapter"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:minWidth="68dp"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:text="下一章"
                    android:textSize="13sp" />
            </LinearLayout>

            <View
                android:id="@+id/read_v_bottom_menu_rule"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:orientation="horizontal"
                android:paddingLeft="8dp"
                android:paddingRight="8dp">

                <TextView
                    android:id="@+id/read_tv_category"
                    style="@style/Ink.ReaderMenuAction"
                    android:drawableTop="@drawable/ic_ink_toc"
                    android:text="@string/nb.read.category" />

                <TextView
                    android:id="@+id/read_tv_night_mode"
                    style="@style/Ink.ReaderMenuAction"
                    android:drawableTop="@drawable/ic_ink_night"
                    android:text="@string/nb.mode.night" />

                <TextView
                    android:id="@+id/read_tv_setting"
                    style="@style/Ink.ReaderMenuAction"
                    android:drawableTop="@drawable/ic_ink_text_size"
                    android:text="@string/nb.read.setting" />
            </LinearLayout>
        </com.ldp.reader.ui.glass.GlassLinearLayout>
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/read_ll_catalog_drawer"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/nb.read.bg_1"
        android:clickable="true"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/read_ll_catalog_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingTop="20dp"
            android:paddingRight="12dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/read_tv_catalog_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="serif"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:paddingRight="8dp"
                android:text="目录"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/read_tv_catalog_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:includeFontPadding="false"
                android:textSize="12sp"
                tools:text="共 263 章" />

            <LinearLayout
                android:id="@+id/read_ll_catalog_title_toggle_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/read_cb_show_wrong_chapters"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:minHeight="48dp"
                    android:text="@string/reader_show_suspected_wrong_chapters"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/read_ll_wrong_analysis_loading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/read_pb_wrong_analysis"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:indeterminate="true" />

                <TextView
                    android:id="@+id/read_tv_wrong_analysis_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:layout_weight="1"
                    android:text="@string/reader_wrong_chapter_analysis_running"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:id="@+id/read_v_catalog_divider"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/ink_reader_line" />

        <ListView
            android:id="@+id/read_iv_category"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:listSelector="@android:color/transparent"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:clipToPadding="false"
            android:scrollbars="none" />
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
