<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/inkBg"
    android:orientation="vertical">

    <include
        android:id="@+id/about_header"
        layout="@layout/view_ink_page_header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingTop="40dp"
        android:paddingRight="16dp">

        <ImageView
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_ink_logo" />

        <TextView
            android:id="@+id/about_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="serif"
            android:includeFontPadding="false"
            android:text="@string/app_name"
            android:textColor="@color/ink_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:includeFontPadding="false"
            android:text="@string/about_slogan"
            android:textAppearance="@style/TextAppearance.Ink.BodySmall" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:background="@drawable/bg_ink_card"
            android:clipToOutline="true"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:id="@+id/about_version_row"
                style="@style/Ink.Row"
                android:background="@null"
                android:clickable="false"
                android:focusable="false">

                <TextView
                    style="@style/Ink.Row.Title"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/about_version_label" />

                <TextView
                    android:id="@+id/about_version"
                    style="@style/Ink.Row.Value"
                    android:layout_marginRight="4dp" />
            </LinearLayout>

            <View style="@style/Ink.Divider.Inset" />

            <LinearLayout
                style="@style/Ink.Row"
                android:background="@null"
                android:clickable="false"
                android:focusable="false">

                <TextView
                    style="@style/Ink.Row.Title"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/about_license_label" />

                <TextView
                    style="@style/Ink.Row.Value"
                    android:layout_marginRight="4dp"
                    android:text="MIT License" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:includeFontPadding="false"
        android:paddingBottom="28dp"
        android:text="@string/about_footer"
        android:textAppearance="@style/TextAppearance.Ink.Caption" />
</LinearLayout>
