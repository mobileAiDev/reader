<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	android:orientation="vertical"
	android:layout_width="match_parent"
	android:layout_height="match_parent">
	<!--path-->
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="48dp"
		android:orientation="horizontal">
		<TextView
			style="@style/NB.Theme.TextAppearance.Common.SingleLine"
			android:id="@+id/file_category_tv_path"
			android:layout_width="0dp"
			android:layout_height="match_parent"
			android:layout_weight="1"
			android:gravity="center_vertical"
			android:padding="10dp"
			android:textSize="12dp"
			android:textColor="@color/nb.text.common_h2"
			tools:text="存储卡:/"/>
		
		<View
			android:layout_width="2dp"
			android:layout_height="match_parent"
			android:layout_marginTop="5dp"
			android:layout_marginBottom="5dp"
			android:background="?attr/inkDivider"/>
		
			<TextView
				android:id="@+id/file_category_tv_back_last"
				android:layout_width="80dp"
				android:layout_height="48dp"
				android:gravity="center"
				android:text="@string/local_import_up_one_level"
			android:textSize="12dp"
			android:drawableLeft="@drawable/ic_back_last"
			android:textColor="@color/nb.text.common_h2"/>
	</LinearLayout>
	
	<FrameLayout
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1">

		<androidx.recyclerview.widget.RecyclerView
			android:id="@+id/file_category_rv_content"
			android:layout_width="match_parent"
			android:layout_height="match_parent" />

		<TextView
			android:id="@+id/file_category_empty"
			style="@style/NB.Theme.TextAppearance.Common.SingleLine"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:gravity="center"
			android:padding="24dp"
			android:text="@string/nb_file_directory_empty"
			android:textColor="@color/nb.text.common_h2"
			android:textSize="14sp"
			android:visibility="gone" />
	</FrameLayout>
</LinearLayout>
