<?xml version="1.0" encoding="utf-8"?>
<!-- One file or folder: name over a quiet meta line, the select or state mark centred at the end. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingLeft="20dp"
    android:paddingTop="14dp"
    android:paddingRight="12dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/file_tv_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:textColor="@color/ink_text_primary"
            android:textSize="15sp"
            tools:text="codex-local-import-probe.txt" />

        <TextView
            android:id="@+id/file_tv_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="middle"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/ink_text_tertiary"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="/storage/emulated/0/Download" />

        <LinearLayout
            android:id="@+id/file_ll_brief"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/file_tv_tag"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:background="@drawable/bg_file_row_tag"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="40dp"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:text="TXT"
                android:textColor="@color/ink_on_primary"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/file_tv_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:includeFontPadding="false"
                android:textColor="@color/ink_text_tertiary"
                android:textSize="12sp"
                tools:text="23.29 kb" />

            <TextView
                android:id="@+id/file_tv_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:includeFontPadding="false"
                android:textColor="@color/ink_text_tertiary"
                android:textSize="12sp"
                tools:text="2026-05-16" />
        </LinearLayout>

        <TextView
            android:id="@+id/file_tv_sub_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:includeFontPadding="false"
            android:textColor="@color/ink_text_tertiary"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="文件夹" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/file_fl_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_vertical"
        android:layout_marginLeft="8dp">

        <ImageView
            android:id="@+id/file_iv_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:visibility="gone"
            tools:src="@drawable/ic_file_row_folder_32" />

        <CheckBox
            android:id="@+id/file_cb_select"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:background="@android:color/transparent"
            android:button="@drawable/selector_file_reader_check"
            android:clickable="false"
            android:enabled="false"
            android:focusableInTouchMode="false"
            android:minWidth="0dp"
            android:minHeight="0dp" />
    </FrameLayout>
</LinearLayout>
