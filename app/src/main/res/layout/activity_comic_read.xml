<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/media_reader_dark">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/comic_read_pages"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="48dp" />

    <View
        android:id="@+id/comic_read_eye_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#22D8C48A"
        android:visibility="gone" />

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/comic_read_toolbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_reader_top_bar"
        android:theme="@style/Theme.ToolBar.Home"
        app:contentInsetStart="0dp"
        app:contentInsetStartWithNavigation="0dp">

        <TextView
            android:id="@+id/comic_read_title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/media_reader_text"
            android:textSize="17sp"
            tools:text="第 1 话" />
    </androidx.appcompat.widget.Toolbar>

    <TextView
        android:id="@+id/comic_read_state"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_reader_progress_pill"
        android:ellipsize="end"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxWidth="240dp"
        android:minWidth="74dp"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:singleLine="true"
        android:textColor="@color/media_reader_text"
        android:textSize="12sp"
        tools:text="1 / 42" />

    <TextView
        android:id="@+id/comic_read_retry"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_comic_action_primary"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:importantForAccessibility="yes"
        android:minWidth="220dp"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:visibility="gone"
        tools:text="当前图片加载失败，点击重试"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/comic_read_bottom_panel"
        android:layout_width="match_parent"
        android:layout_height="210dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_reader_bottom_bar"
        android:orientation="vertical"
        android:paddingLeft="18dp"
        android:paddingTop="12dp"
        android:paddingRight="18dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/comic_read_prev_chapter"
                android:layout_width="68dp"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:text="@string/reader_previous_chapter"
                android:textColor="@color/media_reader_text_muted"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/comic_read_page_seek"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="@string/reader_comic_page_seek"
                android:max="1000" />

            <TextView
                android:id="@+id/comic_read_next_chapter"
                android:layout_width="68dp"
                android:layout_height="match_parent"
                android:gravity="center_vertical|right"
                android:includeFontPadding="false"
                android:text="@string/reader_next_chapter"
                android:textColor="@color/media_reader_text_muted"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/comic_read_catalog"
                style="@style/MediaReaderPanelAction"
                android:text="@string/reader_catalog" />

            <TextView
                android:id="@+id/comic_read_night"
                style="@style/MediaReaderPanelAction"
                android:text="@string/reader_night" />

            <TextView
                android:id="@+id/comic_read_eye"
                style="@style/MediaReaderPanelAction"
                android:text="@string/reader_eye_protection" />

            <TextView
                android:id="@+id/comic_read_direction"
                style="@style/MediaReaderPanelAction"
                android:text="@string/reader_vertical_pages" />

            <TextView
                android:id="@+id/comic_read_landscape"
                style="@style/MediaReaderPanelAction"
                android:text="@string/reader_landscape" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="42dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/reader_brightness_dim"
                android:textColor="@color/media_reader_text_muted"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/comic_read_brightness"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="@string/reader_brightness_seek"
                android:max="100"
                android:progress="80" />

            <TextView
                android:layout_width="42dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/reader_brightness_bright"
                android:textColor="@color/media_reader_text_muted"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
