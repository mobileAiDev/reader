<?xml version="1.0" encoding="utf-8"?>
<!-- "Continue reading": the most recent book, full width above the grid. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="4dp"
    android:paddingBottom="18dp">

    <LinearLayout
        android:id="@+id/shelf_hero_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_ink_card"
        android:clipToOutline="true"
        android:clickable="true"
        android:elevation="2dp"
        android:focusable="true"
        android:foreground="@drawable/fg_ink_card_ripple"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <com.ldp.reader.ui.widget.CoverFrameLayout
            android:layout_width="66dp"
            android:layout_height="wrap_content"
            android:elevation="3dp">

            <FrameLayout
                android:id="@+id/shelf_hero_text_cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_bookshelf_local_cover">

                <TextView
                    android:id="@+id/shelf_hero_text_cover_title"
                    style="@style/Ink.BookTitleSlip"
                    android:layout_marginLeft="7dp"
                    android:layout_marginTop="7dp"
                    android:maxLines="6"
                    android:textSize="9sp" />
            </FrameLayout>

            <ImageView
                android:id="@+id/shelf_hero_cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />
        </com.ldp.reader.ui.widget.CoverFrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:letterSpacing="0.08"
                android:text="@string/shelf_hero_label"
                android:textColor="@color/ink_text_tertiary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/shelf_hero_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:ellipsize="end"
                android:fontFamily="?attr/inkTitleFont"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/ink_text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="剑来" />

            <TextView
                android:id="@+id/shelf_hero_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/ink_text_secondary"
                android:textSize="12sp"
                tools:text="已读 36% · 烽火戏诸侯" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/shelf_hero_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:max="1000"
                app:indicatorColor="@color/ink_primary"
                app:trackColor="@color/ink_surface_variant"
                app:trackCornerRadius="2dp"
                app:trackThickness="3dp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/shelf_hero_action"
            style="@style/Widget.Ink.Button"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginLeft="12dp"
            android:insetTop="7dp"
            android:insetBottom="7dp"
            android:minWidth="0dp"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:text="@string/shelf_hero_continue"
            android:textSize="13sp"
            app:cornerRadius="17dp" />
    </LinearLayout>
</FrameLayout>
