<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/media_surface"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/media_catalog_toolbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/media_surface"
        android:paddingRight="12dp"
        android:theme="@style/Theme.ToolBar.Home"
        app:contentInsetStart="0dp"
        app:contentInsetStartWithNavigation="0dp">

        <TextView
            android:id="@+id/media_catalog_title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/media_text_primary"
            android:textSize="20sp"
            tools:text="快穿系统：反派大佬不好惹[漫画]" />
    </androidx.appcompat.widget.Toolbar>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="@color/media_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="22dp"
        android:paddingRight="22dp">

        <TextView
            android:id="@+id/media_catalog_tab_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:text="书籍目录"
            android:textColor="@color/home_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/media_catalog_order"
            android:layout_width="72dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="倒序"
            android:textColor="@color/media_text_primary"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/media_catalog_state"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/media_surface_soft"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:paddingLeft="22dp"
        android:paddingRight="22dp"
        android:textColor="@color/media_text_secondary"
        android:textSize="14sp"
        tools:text="全部 316 话" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/media_catalog_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="18dp" />
</LinearLayout>
