<?xml version="1.0" encoding="utf-8"?>
<!-- Opening a shared file: a book outline breathing while the file is read, with a thin bar. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/inkBg">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <com.ldp.reader.ui.widget.SkeletonPulseLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no">

            <View
                android:layout_width="72dp"
                android:layout_height="96dp"
                android:background="@drawable/bg_ink_skeleton" />
        </com.ldp.reader.ui.widget.SkeletonPulseLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:includeFontPadding="false"
            android:text="正在打开文件…"
            android:textColor="@color/ink_text_secondary"
            android:textSize="14sp" />

        <ProgressBar
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="120dp"
            android:layout_height="2dp"
            android:layout_marginTop="16dp"
            android:contentDescription="正在打开文件"
            android:indeterminate="true"
            android:indeterminateTint="@color/ink_primary" />
    </LinearLayout>
</FrameLayout>
