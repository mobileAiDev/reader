<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="24dp"
    android:paddingRight="24dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_ink_drag_handle" />

    <TextView
        android:id="@+id/bookshelf_remove_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:includeFontPadding="false"
        android:text="@string/home_bookshelf_remove_title"
        android:textAppearance="@style/TextAppearance.Ink.Headline" />

    <TextView
        android:id="@+id/bookshelf_remove_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="3dp"
        android:text="@string/home_bookshelf_remove_message"
        android:textAppearance="@style/TextAppearance.Ink.BodySmall"
        android:textSize="15sp" />

    <CheckBox
        android:id="@+id/bookshelf_remove_delete_local_file"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:layout_marginLeft="-6dp"
        android:checked="false"
        android:minWidth="48dp"
        android:text="@string/home_bookshelf_remove_delete_local_file"
        android:textColor="@color/ink_text_primary"
        android:textSize="15sp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/bookshelf_remove_confirm"
        style="@style/Widget.Ink.Button.Danger"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="24dp"
        android:text="@string/home_bookshelf_remove_confirm" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/bookshelf_remove_cancel"
        style="@style/Widget.Ink.Button.Text"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:text="@string/nb.common.cancel"
        android:textColor="@color/ink_text_secondary" />
</LinearLayout>
