<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bookshelf_remove_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="24dp"
    android:paddingEnd="20dp"
    android:paddingBottom="28dp">

    <TextView
        android:id="@+id/bookshelf_remove_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/home_bookshelf_remove_title"
        android:textColor="@color/home_text_primary"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/bookshelf_remove_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/home_bookshelf_remove_message"
        android:textColor="@color/home_text_primary"
        android:textSize="16sp" />

    <CheckBox
        android:id="@+id/bookshelf_remove_delete_local_file"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:button="@drawable/selector_bookshelf_edit_check"
        android:buttonTint="@null"
        android:checked="false"
        android:gravity="center_vertical"
        android:minWidth="48dp"
        android:paddingStart="6dp"
        android:text="@string/home_bookshelf_remove_delete_local_file"
        android:textColor="@color/home_text_primary"
        android:textSize="16sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/bookshelf_remove_confirm"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_bookshelf_remove_confirm"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/home_bookshelf_remove_confirm"
        android:textColor="@color/home_text_on_primary"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/bookshelf_remove_cancel"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_bookshelf_remove_cancel"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/nb.common.cancel"
        android:textColor="@color/settings_text_secondary"
        android:textSize="16sp" />
</LinearLayout>
