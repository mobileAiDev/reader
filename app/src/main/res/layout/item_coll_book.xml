<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/selector_home_book_card_long_press"
    android:clipChildren="false"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="18dp">

    <com.ldp.reader.ui.widget.CoverFrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <FrameLayout
            android:id="@+id/coll_book_local_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_bookshelf_local_cover">

            <TextView
                android:id="@+id/coll_book_local_cover_title"
                style="@style/Ink.BookTitleSlip"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="12dp"
                android:maxLines="7"
                android:textSize="12sp"
                tools:text="剑\n来" />

            <TextView
                android:id="@+id/coll_book_local_cover_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal|bottom"
                android:layout_marginBottom="14dp"
                android:includeFontPadding="false"
                android:letterSpacing="0.2"
                android:textColor="@color/book_cloth_label"
                android:textSize="10sp"
                tools:text="TXT" />
        </FrameLayout>

        <ImageView
            android:id="@+id/coll_book_iv_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/coll_book_iv_top"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="left|bottom"
            android:layout_margin="6dp"
            android:background="@drawable/bg_ink_badge_scrim"
            android:contentDescription="@string/home_bookshelf_pinned"
            android:padding="4dp"
            android:src="@drawable/ic_ink_pin"
            android:visibility="gone"
            app:tint="@color/white"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/coll_book_iv_red_rot"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:layout_gravity="right|top"
            android:layout_margin="6dp"
            android:background="@drawable/bg_ink_badge_accent"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:text="@string/bookshelf_badge_updated"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <CheckBox
            android:id="@+id/coll_book_cb_selected"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="right|top"
            android:layout_margin="4dp"
            android:background="@android:color/transparent"
            android:button="@drawable/selector_bookshelf_edit_check"
            android:clickable="false"
            android:focusable="false"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:visibility="gone"
            app:buttonTint="@null"
            app:useMaterialThemeColors="false"
            tools:visibility="visible" />
    </com.ldp.reader.ui.widget.CoverFrameLayout>

    <!-- Title and progress under the cover; themes with real shelves hide them. -->
    <LinearLayout
        android:id="@+id/coll_book_captions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/coll_book_tv_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:textColor="@color/ink_text_primary"
            android:textSize="14sp"
            tools:text="逆鳞" />

        <TextView
            android:id="@+id/coll_book_tv_lately_update"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/ink_text_tertiary"
            android:textSize="12sp"
            tools:text="17小时前更新" />

        <TextView
            android:id="@+id/coll_book_tv_chapter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/ink_text_tertiary"
            android:textSize="12sp"
            tools:text="第二卷 逆水行舟" />
    </LinearLayout>
</LinearLayout>
