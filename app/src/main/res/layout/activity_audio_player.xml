<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_audio_player_netease">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/audio_player_toolbar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@android:color/transparent"
            android:paddingRight="12dp"
            android:theme="@style/Theme.ToolBar.Home"
            app:contentInsetStart="0dp"
            app:contentInsetStartWithNavigation="0dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingLeft="48dp"
            android:paddingRight="48dp">

            <TextView
                android:id="@+id/audio_player_title"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/media_audio_player_text_primary"
                android:textSize="18sp"
                tools:text="凡人修仙传" />

            <TextView
                android:id="@+id/audio_player_episode"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/media_audio_player_text_secondary"
                android:textSize="13sp"
                tools:text="第56集_狐媚" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/audio_player_tabs"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="96dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/audio_player_tab_now"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="播放中"
                    android:textColor="@color/media_audio_player_text_primary"
                    android:textSize="16sp" />

                <View
                    android:id="@+id/audio_player_tab_now_line"
                    android:layout_width="18dp"
                    android:layout_height="2dp"
                    android:layout_marginBottom="4dp"
                    android:background="@color/media_audio_player_text_primary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="96dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/audio_player_tab_catalog"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="目录"
                    android:textColor="@color/media_audio_player_text_secondary"
                    android:textSize="16sp" />

                <View
                    android:id="@+id/audio_player_tab_catalog_line"
                    android:layout_width="18dp"
                    android:layout_height="2dp"
                    android:layout_marginBottom="4dp"
                    android:background="@color/media_audio_player_text_primary"
                    android:visibility="invisible" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/audio_player_now_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingLeft="24dp"
                android:paddingRight="24dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <FrameLayout
                        android:layout_width="288dp"
                        android:layout_height="288dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_audio_vinyl_record"
                        android:elevation="8dp"
                        android:padding="66dp">

                        <ImageView
                            android:id="@+id/audio_player_cover"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_audio_cover_ring"
                            android:padding="4dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_book_cover_placeholder" />
                    </FrameLayout>

                    <ImageView
                        android:id="@+id/audio_player_tonearm"
                        android:layout_width="148dp"
                        android:layout_height="118dp"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginLeft="84dp"
                        android:layout_marginTop="0dp"
                        android:elevation="24dp"
                        android:src="@drawable/ic_audio_tonearm"
                        android:translationZ="24dp"
                        tools:ignore="RtlHardcoded" />
                </FrameLayout>

                <TextView
                    android:id="@+id/audio_player_state"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/media_audio_player_text_secondary"
                    android:textSize="14sp"
                    tools:text="正在缓冲" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/audio_player_catalog_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:paddingBottom="18dp"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/audio_player_control_panel"
            android:layout_width="match_parent"
            android:layout_height="224dp"
            android:orientation="vertical"
            android:paddingLeft="28dp"
            android:paddingRight="28dp"
            android:paddingBottom="16dp">

            <SeekBar
                android:id="@+id/audio_player_progress"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:max="1000"
                android:paddingLeft="0dp"
                android:paddingRight="0dp"
                android:progress="0"
                android:progressDrawable="@drawable/audio_seekbar_progress_dark"
                android:thumb="@drawable/audio_seekbar_thumb_dark"
                android:splitTrack="false" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/audio_player_elapsed"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:text="00:00"
                    android:textColor="@color/media_audio_player_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/audio_player_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:text="00:00"
                    android:textColor="@color/media_audio_player_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="86dp"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/audio_player_rewind"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_audio_control_icon_dark"
                    android:contentDescription="后退15秒"
                    android:padding="20dp"
                    android:scaleType="center"
                    android:src="@drawable/ic_audio_legado_rewind_24"
                    app:tint="@color/media_audio_player_text_secondary" />

                <ImageButton
                    android:id="@+id/audio_player_previous"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_audio_control_icon_dark"
                    android:contentDescription="上一集"
                    android:padding="20dp"
                    android:scaleType="center"
                    android:src="@drawable/ic_audio_legado_skip_previous_24"
                    app:tint="@color/media_audio_player_text_secondary" />

                <ImageButton
                    android:id="@+id/audio_player_play_pause"
                    android:layout_width="80dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_audio_control_icon_dark"
                    android:contentDescription="播放"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_audio_player_play_round"
                    app:tint="@color/media_audio_player_text_primary" />

                <ImageButton
                    android:id="@+id/audio_player_next"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_audio_control_icon_dark"
                    android:contentDescription="下一集"
                    android:padding="20dp"
                    android:scaleType="center"
                    android:src="@drawable/ic_audio_legado_skip_next_24"
                    app:tint="@color/media_audio_player_text_secondary" />

                <ImageButton
                    android:id="@+id/audio_player_forward"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_audio_control_icon_dark"
                    android:contentDescription="快进15秒"
                    android:padding="20dp"
                    android:scaleType="center"
                    android:src="@drawable/ic_audio_legado_forward_24"
                    app:tint="@color/media_audio_player_text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/audio_player_speed"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="倍速"
                    android:textColor="@color/media_audio_player_text_secondary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/audio_player_sleep"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="定时"
                    android:textColor="@color/media_audio_player_text_secondary"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/audio_player_float"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_gravity="right|bottom"
        android:layout_marginRight="18dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_audio_float"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="7dp"
        android:paddingRight="7dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/audio_player_float_cover"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_audio_disc"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_book_cover_placeholder" />
    </LinearLayout>
</FrameLayout>
