<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/inkBg"
    android:orientation="vertical">

    <include
        android:id="@+id/settings_header"
        layout="@layout/view_ink_page_header" />

    <!-- Scrolls on under the navigation bar and fades as it passes under the header. -->
    <com.ldp.reader.ui.widget.TopFadingScrollView
        android:id="@+id/settings_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fadingEdgeLength="24dp"
        android:overScrollMode="never"
        android:requiresFadingEdge="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <TextView
                android:id="@+id/settings_account_section_label"
                style="@style/Ink.SectionLabel"
                android:text="@string/settings_section_account" />

            <LinearLayout
                android:id="@+id/settings_account_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:background="@drawable/bg_ink_card"
                android:clipToOutline="true"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <LinearLayout
                    android:id="@+id/settings_account_entry"
                    style="@style/Ink.Row"
                    android:minHeight="64dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Ink.Row.Title"
                            android:text="@string/settings_account_title" />

                        <TextView
                            style="@style/Ink.Row.Summary"
                            android:text="@string/settings_account_summary" />
                    </LinearLayout>

                    <ImageView style="@style/Ink.Row.Chevron" />
                </LinearLayout>

                <View style="@style/Ink.Divider.Inset" />

                <LinearLayout
                    android:id="@+id/settings_sync_bookshelf"
                    style="@style/Ink.Row"
                    android:minHeight="64dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Ink.Row.Title"
                            android:text="@string/settings_sync_title" />

                        <TextView
                            style="@style/Ink.Row.Summary"
                            android:text="@string/settings_sync_summary" />
                    </LinearLayout>

                    <ImageView style="@style/Ink.Row.Chevron" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/settings_appearance_section_label"
                style="@style/Ink.SectionLabel"
                android:text="@string/settings_section_appearance" />

            <LinearLayout
                android:id="@+id/settings_appearance_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:background="@drawable/bg_ink_card"
                android:clipToOutline="true"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <LinearLayout
                    android:id="@+id/settings_appearance_entry"
                    style="@style/Ink.Row"
                    android:minHeight="64dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Ink.Row.Title"
                            android:text="@string/appearance_title" />

                        <TextView
                            style="@style/Ink.Row.Summary"
                            android:text="@string/settings_appearance_summary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/settings_appearance_value"
                        style="@style/Ink.Row.Value" />

                    <ImageView style="@style/Ink.Row.Chevron" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/settings_content_section_label"
                style="@style/Ink.SectionLabel"
                android:text="@string/settings_section_content" />

            <LinearLayout
                android:id="@+id/settings_content_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:background="@drawable/bg_ink_card"
                android:clipToOutline="true"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <LinearLayout
                    android:id="@+id/settings_local_import"
                    style="@style/Ink.Row"
                    android:minHeight="64dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Ink.Row.Title"
                            android:text="@string/settings_local_import_title" />

                        <TextView
                            style="@style/Ink.Row.Summary"
                            android:text="@string/settings_local_import_summary" />
                    </LinearLayout>

                    <ImageView style="@style/Ink.Row.Chevron" />
                </LinearLayout>

                <View style="@style/Ink.Divider.Inset" />

                <LinearLayout
                    android:id="@+id/settings_clean_content"
                    style="@style/Ink.Row"
                    android:minHeight="64dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Ink.Row.Title"
                            android:text="@string/settings_clean_content" />

                        <TextView
                            style="@style/Ink.Row.Summary"
                            android:text="@string/settings_clean_content_summary" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/settings_clean_content_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>

                <View style="@style/Ink.Divider.Inset" />

                <LinearLayout
                    android:id="@+id/settings_clean_intro"
                    style="@style/Ink.Row"
                    android:minHeight="64dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Ink.Row.Title"
                            android:text="@string/settings_clean_intro" />

                        <TextView
                            style="@style/Ink.Row.Summary"
                            android:text="@string/settings_clean_intro_summary" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/settings_clean_intro_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>

                <View style="@style/Ink.Divider.Inset" />

                <LinearLayout
                    android:id="@+id/settings_smart_wrong_chapter"
                    style="@style/Ink.Row"
                    android:minHeight="64dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Ink.Row.Title"
                            android:text="@string/settings_smart_wrong_chapter" />

                        <TextView
                            style="@style/Ink.Row.Summary"
                            android:text="@string/settings_smart_wrong_chapter_summary" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/settings_smart_wrong_chapter_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/settings_storage_section_label"
                style="@style/Ink.SectionLabel"
                android:text="@string/settings_section_storage" />

            <LinearLayout
                android:id="@+id/settings_storage_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:background="@drawable/bg_ink_card"
                android:clipToOutline="true"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <LinearLayout
                    android:id="@+id/settings_clear_cache"
                    style="@style/Ink.Row"
                    android:minHeight="64dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Ink.Row.Title"
                            android:text="@string/settings_clear_cache_title" />

                        <TextView
                            style="@style/Ink.Row.Summary"
                            android:text="@string/settings_clear_cache_summary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/settings_cache_summary"
                        style="@style/Ink.Row.Value" />
                </LinearLayout>

                <View style="@style/Ink.Divider.Inset" />

                <LinearLayout
                    android:id="@+id/settings_about_entry"
                    style="@style/Ink.Row"
                    android:minHeight="64dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Ink.Row.Title"
                            android:text="@string/settings_about_title" />

                        <TextView
                            style="@style/Ink.Row.Summary"
                            android:text="@string/settings_about_summary" />
                    </LinearLayout>

                    <ImageView style="@style/Ink.Row.Chevron" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.ldp.reader.ui.widget.TopFadingScrollView>
</LinearLayout>
