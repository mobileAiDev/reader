<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/inkSurfaceVariant">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/pdf_read_pages"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="32dp" />

    <View
        android:id="@+id/pdf_read_status_scrim"
        android:layout_width="match_parent"
        android:layout_height="@dimen/media_reader_status_scrim"
        android:layout_gravity="top"
        android:background="@drawable/bg_media_reader_status_scrim"
        android:importantForAccessibility="no"
        android:visibility="invisible" />

    <!-- Floating glass bars, sprung in from the edges by FloatingBar. -->
    <com.ldp.reader.ui.glass.GlassFrameLayout
        android:id="@+id/pdf_read_top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="top"
        android:layout_marginLeft="@dimen/reader_float_margin"
        android:layout_marginTop="@dimen/reader_float_margin"
        android:layout_marginRight="@dimen/reader_float_margin"
        android:clickable="true"
        android:elevation="10dp"
        android:visibility="invisible"
        app:glassCorner="22dp"
        app:glassLook="bar"
        tools:visibility="visible">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/pdf_read_toolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@android:color/transparent"
            android:theme="@style/Theme.ToolBar.Reader"
            app:contentInsetStart="0dp"
            app:contentInsetStartWithNavigation="0dp">

            <TextView
                android:id="@+id/pdf_read_title"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/media_reader_text"
                android:textSize="17sp"
                tools:text="文档.pdf" />
        </androidx.appcompat.widget.Toolbar>
    </com.ldp.reader.ui.glass.GlassFrameLayout>

    <com.ldp.reader.ui.glass.GlassLinearLayout
        android:id="@+id/pdf_read_bottom_panel"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:layout_marginLeft="@dimen/reader_float_margin"
        android:layout_marginRight="@dimen/reader_float_margin"
        android:layout_marginBottom="@dimen/reader_float_margin"
        android:clickable="true"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:visibility="invisible"
        app:glassCorner="26dp"
        app:glassLook="bar"
        tools:visibility="visible">

        <TextView
            android:id="@+id/pdf_read_prev"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:enabled="false"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minWidth="68dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="@string/reader_previous_page"
            android:textColor="@color/media_reader_action"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/pdf_read_catalog"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:drawableLeft="@drawable/ic_ink_toc"
            android:drawablePadding="6dp"
            android:drawableTint="@color/media_reader_action"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="@string/reader_jump_page"
            android:textColor="@color/media_reader_action"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/pdf_read_page_number"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:minWidth="48dp"
            android:paddingRight="8dp"
            android:includeFontPadding="false"
            android:textColor="@color/media_reader_text"
            android:textSize="14sp"
            tools:text="1 / 12" />

        <TextView
            android:id="@+id/pdf_read_next"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:enabled="false"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minWidth="68dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="@string/reader_next_page"
            android:textColor="@color/media_reader_action"
            android:textSize="13sp" />
    </com.ldp.reader.ui.glass.GlassLinearLayout>

    <TextView
        android:id="@+id/pdf_read_progress"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_reader_progress_pill"
        android:gravity="center"
        android:includeFontPadding="false"
        android:minWidth="74dp"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:textColor="@color/media_reader_text"
        android:textSize="12sp"
        tools:text="1 / 12" />
</FrameLayout>
