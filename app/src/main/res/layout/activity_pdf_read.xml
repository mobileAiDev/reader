<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/media_surface_soft">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/pdf_read_pages"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="32dp" />

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/pdf_read_toolbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_reader_top_bar"
        android:theme="@style/Theme.ToolBar.Home"
        app:contentInsetStart="0dp"
        app:contentInsetStartWithNavigation="0dp">

        <TextView
            android:id="@+id/pdf_read_title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/media_reader_text"
            android:textSize="17sp"
            tools:text="文档.pdf" />
    </androidx.appcompat.widget.Toolbar>

    <LinearLayout
        android:id="@+id/pdf_read_bottom_panel"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_reader_bottom_bar"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingLeft="20dp"
        android:paddingRight="20dp">

        <TextView
            android:id="@+id/pdf_read_prev"
            android:layout_width="78dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_media_outline_button"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="上一页"
            android:textColor="@color/media_text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/pdf_read_catalog"
            android:layout_width="64dp"
            android:layout_height="40dp"
            android:layout_marginLeft="10dp"
            android:background="@drawable/bg_media_outline_button"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="目录"
            android:textColor="@color/media_text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/pdf_read_page_number"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="@color/media_reader_text"
            android:textSize="14sp"
            tools:text="1 / 12" />

        <TextView
            android:id="@+id/pdf_read_next"
            android:layout_width="78dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_media_outline_button"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="下一页"
            android:textColor="@color/media_text_primary"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/pdf_read_progress"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_reader_progress_pill"
        android:gravity="center"
        android:includeFontPadding="false"
        android:minWidth="74dp"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:textColor="@color/media_reader_text"
        android:textSize="12sp"
        tools:text="1 / 12" />
</FrameLayout>
