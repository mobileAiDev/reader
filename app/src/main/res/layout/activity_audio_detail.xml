<?xml version="1.0" encoding="utf-8"?>
<!--
  Audiobook detail, laid out like the book detail page: the cover centred over a soft wash of its
  own colours, the brief and the first episodes below, what is playing in a glass capsule, and the
  actions on a floating glass bar.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/inkBg">

    <ImageView
        android:id="@+id/audio_detail_ambient"
        android:layout_width="match_parent"
        android:layout_height="@dimen/book_detail_ambient_height"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/book_detail_ambient_height"
        android:background="@drawable/bg_book_detail_ambient_fade" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/audio_detail_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:minHeight="56dp"
            android:theme="@style/Theme.ToolBar.Home"
            app:contentInsetStart="0dp"
            app:contentInsetStartWithNavigation="0dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.ldp.reader.ui.widget.TopFadingScrollView
                android:id="@+id/audio_detail_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fadingEdgeLength="24dp"
                android:overScrollMode="never"
                android:requiresFadingEdge="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingLeft="24dp"
                    android:paddingTop="8dp"
                    android:paddingRight="24dp"
                    android:paddingBottom="28dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/audio_detail_cover"
                            android:layout_width="@dimen/media_detail_audio_cover"
                            android:layout_height="@dimen/media_detail_audio_cover"
                            android:background="?attr/inkCoverPlaceholder"
                            android:contentDescription="@null"
                            android:elevation="14dp"
                            android:outlineSpotShadowColor="@color/ink_glass_shadow"
                            android:padding="0.5dp"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Ink.AudioCover"
                            app:strokeColor="@color/ink_cover_stroke"
                            app:strokeWidth="0.5dp" />

                        <TextView
                            android:id="@+id/audio_detail_title"
                            style="@style/Ink.MediaDetail.Title"
                            tools:text="三体-面壁者" />

                        <TextView
                            android:id="@+id/audio_detail_meta"
                            style="@style/Ink.MediaDetail.Meta"
                            tools:text="君问" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/audio_detail_state"
                                style="@style/Ink.MediaDetail.Pill"
                                tools:text="共 313 集" />

                            <TextView
                                android:id="@+id/audio_detail_play_latest"
                                style="@style/Ink.MediaDetail.Pill.Action"
                                android:layout_marginLeft="8dp"
                                tools:text="最新 · 第313集" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        style="@style/Ink.MediaDetail.SectionLabel"
                        android:text="@string/nb.book_detail.brief_title" />

                    <TextView
                        android:id="@+id/audio_detail_intro"
                        style="@style/Ink.MediaDetail.Intro"
                        tools:text="无法被破壁的面壁人……" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="26dp"
                        android:gravity="center_vertical"
                        android:minHeight="40dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/audio_detail_episode_title"
                            style="@style/Ink.MediaDetail.SectionLabel.Inline"
                            android:text="@string/media_detail_episodes" />

                        <TextView
                            android:id="@+id/audio_detail_episode_hint"
                            style="@style/Ink.MediaDetail.SectionHint"
                            tools:text="共 313 集" />

                        <TextView
                            android:id="@+id/audio_detail_order"
                            style="@style/Ink.MediaDetail.SectionAction"
                            android:text="倒序" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/audio_detail_episodes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                    <TextView
                        android:id="@+id/audio_detail_catalog_all"
                        style="@style/Ink.MediaDetail.AllChapters"
                        android:text="@string/media_detail_all_chapters" />
                </LinearLayout>
            </com.ldp.reader.ui.widget.TopFadingScrollView>

            <!-- Loading: the outline of the page breathing in place, with the current step beneath. -->
            <LinearLayout
                android:id="@+id/audio_detail_loading_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/inkBg"
                android:clickable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="visible">

                <include
                    layout="@layout/view_book_detail_skeleton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/audio_detail_loading_title"
                    style="@style/Ink.MediaDetail.LoadingTitle"
                    android:text="正在加载" />

                <TextView
                    android:id="@+id/audio_detail_loading_step"
                    style="@style/Ink.MediaDetail.LoadingStep"
                    android:text="正在加载作品信息" />

                <ProgressBar
                    android:id="@+id/audio_detail_loading_progress"
                    style="@style/Ink.MediaDetail.LoadingProgress"
                    android:indeterminate="true" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/audio_detail_loading_retry"
                    style="@style/Widget.Ink.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="20dp"
                    android:minWidth="160dp"
                    android:text="重新加载"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- What is playing now, floating just above the action bar. -->
    <com.ldp.reader.ui.glass.GlassLinearLayout
        android:id="@+id/audio_detail_mini_player"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="@dimen/media_detail_mini_player_lift"
        android:clickable="true"
        android:elevation="12dp"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="10dp"
        android:paddingRight="8dp"
        android:visibility="gone"
        app:glassLook="bar"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/audio_detail_mini_cover"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_audio_disc"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_book_cover_placeholder" />

        <TextView
            android:id="@+id/audio_detail_mini_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/ink_text_primary"
            android:textSize="14sp"
            tools:text="016 真.欲火焚身" />

        <ImageView
            android:id="@+id/audio_detail_mini_action"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_audio_play_button"
            android:contentDescription="播放"
            android:padding="10dp"
            android:scaleType="center"
            android:src="@drawable/ic_audio_legado_play_24"
            app:tint="@color/ink_on_primary" />
    </com.ldp.reader.ui.glass.GlassLinearLayout>

    <com.ldp.reader.ui.glass.GlassLinearLayout
        android:id="@+id/audio_detail_bottom_bar"
        style="@style/Ink.MediaDetail.ActionBar"
        app:glassLook="bar">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/audio_detail_add_shelf"
            style="@style/Ink.MediaDetail.SecondaryAction"
            android:text="加入书架"
            app:icon="@drawable/ic_ink_add" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/audio_detail_play_first"
            style="@style/Ink.MediaDetail.PrimaryAction"
            android:text="@string/media_detail_listen" />
    </com.ldp.reader.ui.glass.GlassLinearLayout>
</FrameLayout>
