<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/media_bg"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/audio_detail_toolbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/media_surface"
        android:paddingRight="12dp"
        android:theme="@style/Theme.ToolBar.Home"
        app:contentInsetStart="0dp"
        app:contentInsetStartWithNavigation="0dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="听书"
            android:textColor="@color/media_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />
    </androidx.appcompat.widget.Toolbar>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingBottom="88dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_media_panel"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/audio_detail_cover"
                            android:layout_width="108dp"
                            android:layout_height="144dp"
                            android:background="@drawable/bg_audio_album"
                            android:scaleType="centerCrop" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/audio_detail_title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:includeFontPadding="false"
                                android:maxLines="3"
                                android:textColor="@color/media_text_primary"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                tools:text="凡人修仙传" />

                            <TextView
                                android:id="@+id/audio_detail_meta"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:ellipsize="end"
                                android:lineSpacingExtra="3dp"
                                android:maxLines="3"
                                android:textColor="@color/media_text_secondary"
                                android:textSize="14sp"
                                tools:text="忘语 | 更新至第1200集" />

                            <TextView
                                android:id="@+id/audio_detail_state"
                                android:layout_width="wrap_content"
                                android:layout_height="30dp"
                                android:layout_marginTop="12dp"
                                android:background="@drawable/bg_media_chip"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:paddingLeft="12dp"
                                android:paddingRight="12dp"
                                android:textColor="@color/media_audio_accent"
                                android:textSize="13sp"
                                tools:text="加载中" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/audio_detail_add_shelf"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_media_outline_button"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:text="加入书架"
                            android:textColor="@color/media_audio_accent"
                            android:textSize="15sp" />

                        <Button
                            android:id="@+id/audio_detail_play_first"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_marginLeft="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_audio_action_primary"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:text="播放第一集"
                            android:textColor="@color/home_text_on_primary"
                            android:textSize="16sp" />

                        <Button
                            android:id="@+id/audio_detail_play_latest"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_marginLeft="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_audio_action_primary"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:text="最新一集"
                            android:textColor="@color/home_text_on_primary"
                            android:textSize="16sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:includeFontPadding="false"
                    android:text="简介"
                    android:textColor="@color/media_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/audio_detail_intro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_media_panel"
                    android:ellipsize="end"
                    android:lineSpacingExtra="5dp"
                    android:maxLines="5"
                    android:padding="14dp"
                    android:textColor="@color/media_text_secondary"
                    android:textSize="14sp"
                    tools:text="平凡少年踏入修仙世界。" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="18dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/audio_detail_episode_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:includeFontPadding="false"
                        android:text="剧集"
                        android:textColor="@color/media_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/audio_detail_episode_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:textColor="@color/media_text_tertiary"
                        android:textSize="13sp"
                        tools:text="1200 集" />

                    <TextView
                        android:id="@+id/audio_detail_catalog_all"
                        android:layout_width="76dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="全部目录"
                        android:textColor="@color/media_text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/audio_detail_order"
                        android:layout_width="56dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="倒序"
                        android:textColor="@color/media_audio_accent"
                        android:textSize="14sp" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/audio_detail_episodes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/audio_detail_mini_player"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_gravity="bottom"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_media_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="14dp"
            android:paddingRight="10dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/audio_detail_mini_cover"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_audio_disc"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_book_cover_placeholder" />

            <TextView
                android:id="@+id/audio_detail_mini_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/media_text_primary"
                android:textSize="14sp"
                tools:text="继续播放 第 12 集" />

            <ImageView
                android:id="@+id/audio_detail_mini_action"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_audio_play_button"
                android:contentDescription="播放"
                android:padding="11dp"
                android:scaleType="center"
                android:src="@drawable/ic_audio_legado_play_24" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/audio_detail_loading_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/media_loading_scrim"
            android:gravity="center"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:visibility="visible"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_media_panel"
                android:elevation="10dp"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:id="@+id/audio_detail_loading_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="智能引擎分析中"
                    android:textColor="@color/media_text_primary"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/audio_detail_loading_step"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="准备作品信息"
                    android:textColor="@color/media_text_secondary"
                    android:textSize="14sp" />

                <ProgressBar
                    android:id="@+id/audio_detail_loading_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_marginTop="20dp"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="8"
                    android:progressDrawable="@drawable/media_detail_progress_audio" />

                <TextView
                    android:id="@+id/audio_detail_loading_percent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="8%"
                    android:textColor="@color/media_audio_accent"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
