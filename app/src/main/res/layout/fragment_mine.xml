<?xml version="1.0" encoding="utf-8"?>
<!-- Mine: a large serif title, the reader's card with reading time, then quiet settings rows. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mine_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:id="@+id/mine_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="68dp"
            android:layout_marginLeft="6dp"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:text="@string/home_tab_mine"
            android:textAppearance="@style/TextAppearance.Ink.Display" />

        <LinearLayout
            android:id="@+id/mine_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToOutline="true"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_ink_card"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/mine_profile_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="18dp"
                android:paddingTop="18dp"
                android:paddingRight="14dp"
                android:paddingBottom="16dp">

                <ImageView
                    android:id="@+id/mine_profile_avatar"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_mine_avatar"
                    android:contentDescription="@null"
                    android:padding="15dp"
                    android:src="@drawable/ic_ink_person_filled"
                    app:tint="@color/ink_text_secondary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/mine_profile_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="未登录"
                        android:textAppearance="@style/TextAppearance.Ink.Headline" />

                    <TextView
                        android:id="@+id/mine_profile_reading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/mine_profile_hint_guest"
                        android:textAppearance="@style/TextAppearance.Ink.Caption" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mine_login_entry"
                    style="@style/Widget.Ink.Button.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:insetTop="6dp"
                    android:insetBottom="6dp"
                    android:minHeight="48dp"
                    android:minWidth="0dp"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:text="去登录"
                    android:textSize="13sp" />
            </LinearLayout>

            <View style="@style/Ink.Divider.Inset" android:layout_marginLeft="18dp" android:layout_marginRight="18dp" />

            <LinearLayout
                android:id="@+id/mine_reading_entry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:contentDescription="@string/mine_reading_stats"
                android:focusable="true"
                android:orientation="horizontal"
                android:paddingTop="20dp"
                android:paddingBottom="20dp">

                <LinearLayout
                    android:id="@+id/mine_stat_total"
                    style="@style/Ink.MineStat">

                    <LinearLayout style="@style/Ink.MineStat.Figure">

                        <TextView
                            android:id="@+id/mine_stat_total_value"
                            style="@style/Ink.MineStat.Value"
                            android:text="0" />

                        <TextView
                            android:id="@+id/mine_stat_total_unit"
                            style="@style/Ink.MineStat.Unit"
                            android:text="分钟" />
                    </LinearLayout>

                    <TextView
                        style="@style/Ink.MineStat.Label"
                        android:text="累计阅读" />
                </LinearLayout>

                <View style="@style/Ink.MineStat.Rule" />

                <LinearLayout
                    android:id="@+id/mine_stat_week"
                    style="@style/Ink.MineStat">

                    <LinearLayout style="@style/Ink.MineStat.Figure">

                        <TextView
                            android:id="@+id/mine_stat_week_value"
                            style="@style/Ink.MineStat.Value"
                            android:text="0" />

                        <TextView
                            android:id="@+id/mine_stat_week_unit"
                            style="@style/Ink.MineStat.Unit"
                            android:text="分钟" />
                    </LinearLayout>

                    <TextView
                        style="@style/Ink.MineStat.Label"
                        android:text="本周" />
                </LinearLayout>

                <View style="@style/Ink.MineStat.Rule" />

                <LinearLayout
                    android:id="@+id/mine_stat_today"
                    style="@style/Ink.MineStat">

                    <LinearLayout style="@style/Ink.MineStat.Figure">

                        <TextView
                            android:id="@+id/mine_stat_today_value"
                            style="@style/Ink.MineStat.Value"
                            android:text="0" />

                        <TextView
                            android:id="@+id/mine_stat_today_unit"
                            style="@style/Ink.MineStat.Unit"
                            android:text="分钟" />
                    </LinearLayout>

                    <TextView
                        style="@style/Ink.MineStat.Label"
                        android:text="今日" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/mine_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToOutline="true"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_ink_card"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:id="@+id/mine_books_entry"
                style="@style/Ink.Row">

                <ImageView
                    style="@style/Ink.Row.Icon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_ink_shelf" />

                <TextView
                    style="@style/Ink.Row.Title"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="我的书架" />

                <ImageView style="@style/Ink.Row.Chevron" />
            </LinearLayout>

            <View style="@style/Ink.Divider.Inset" android:layout_marginLeft="52dp" />

            <LinearLayout
                android:id="@+id/mine_appearance_entry"
                style="@style/Ink.Row">

                <ImageView
                    style="@style/Ink.Row.Icon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_ink_contrast" />

                <TextView
                    style="@style/Ink.Row.Title"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/appearance_title" />

                <TextView
                    android:id="@+id/mine_appearance_value"
                    style="@style/Ink.Row.Value" />

                <ImageView style="@style/Ink.Row.Chevron" />
            </LinearLayout>

            <View style="@style/Ink.Divider.Inset" android:layout_marginLeft="52dp" />

            <LinearLayout
                android:id="@+id/mine_settings_entry"
                style="@style/Ink.Row">

                <ImageView
                    style="@style/Ink.Row.Icon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_ink_settings" />

                <TextView
                    style="@style/Ink.Row.Title"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="设置" />

                <ImageView style="@style/Ink.Row.Chevron" />
            </LinearLayout>

            <View style="@style/Ink.Divider.Inset" android:layout_marginLeft="52dp" />

            <LinearLayout
                android:id="@+id/mine_about_entry"
                style="@style/Ink.Row">

                <ImageView
                    style="@style/Ink.Row.Icon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_ink_info" />

                <TextView
                    style="@style/Ink.Row.Title"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/mine_about_title" />

                <ImageView style="@style/Ink.Row.Chevron" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
