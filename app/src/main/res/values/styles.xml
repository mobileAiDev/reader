<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ===================== Theme ===================== -->
    <style name="BaseAppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Every window, the launch window included, draws around a camera cutout; otherwise
             the cutout row stays an unpainted black band. -->
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">shortEdges</item>
        <item name="colorPrimary">@color/ink_primary</item>
        <item name="colorPrimaryDark">@color/ink_bg</item>
        <item name="colorOnPrimary">@color/ink_on_primary</item>
        <item name="colorPrimaryContainer">@color/ink_primary_soft</item>
        <item name="colorOnPrimaryContainer">@color/ink_primary</item>
        <item name="colorSecondary">@color/ink_primary</item>
        <item name="colorOnSecondary">@color/ink_on_primary</item>
        <item name="colorSecondaryContainer">@color/ink_primary_soft</item>
        <item name="colorOnSecondaryContainer">@color/ink_primary</item>
        <item name="colorTertiary">@color/ink_primary</item>
        <item name="colorAccent">@color/ink_primary</item>
        <item name="colorError">@color/ink_danger</item>
        <item name="android:colorBackground">@color/ink_bg</item>
        <item name="colorOnBackground">@color/ink_text_primary</item>
        <item name="colorSurface">@color/ink_surface</item>
        <item name="colorOnSurface">@color/ink_text_primary</item>
        <item name="colorSurfaceVariant">@color/ink_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/ink_text_secondary</item>
        <item name="colorSurfaceInverse">@color/ink_toast_bg</item>
        <item name="colorOnSurfaceInverse">@color/ink_toast_text</item>
        <item name="colorOutline">@color/ink_outline</item>
        <item name="colorControlNormal">@color/ink_text_primary</item>
        <item name="colorControlActivated">@color/ink_primary</item>
        <item name="colorControlHighlight">@color/ink_ripple</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="android:textColorPrimary">@color/ink_text_primary</item>
        <item name="android:textColorSecondary">@color/ink_text_secondary</item>
        <item name="android:textColorTertiary">@color/ink_text_tertiary</item>
        <item name="android:textColorHint">@color/ink_text_tertiary</item>
        <item name="android:textColorLink">@color/ink_primary</item>
        <item name="android:textColorHighlight">@color/ink_primary_soft</item>
        <item name="android:windowBackground">@color/window_paper</item>
        <item name="android:statusBarColor">@color/window_paper</item>
        <item name="android:navigationBarColor">@color/ink_system_nav</item>
        <item name="android:windowLightStatusBar">@bool/ink_light_system_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/ink_light_system_bars</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:listDivider">@drawable/shape_divider_dash</item>
        <item name="android:windowAnimationStyle">@style/Animation.Ink.Activity</item>
        <item name="toolbarStyle">@style/Widget.Ink.Toolbar</item>
        <item name="materialButtonStyle">@style/Widget.Ink.Button</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Ink.AlertDialog</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.Ink.BottomSheetDialog</item>
        <item name="checkboxStyle">@style/Widget.Ink.CheckBox</item>
        <item name="materialSwitchStyle">@style/Widget.Ink.Switch</item>
        <item name="android:actionOverflowMenuStyle">@style/OverflowMenuStyle</item>
        <item name="popupMenuStyle">@style/Widget.Ink.PopupMenu</item>
        <item name="android:fastScrollThumbDrawable">@drawable/shape_ink_fast_scroll_thumb</item>
    </style>

    <style name="AppTheme" parent="BaseAppTheme" />

    <!-- Launch window paints the paper background immediately, light or dark, without a white flash. -->
    <style name="SplashTheme" parent="AppTheme">
        <item name="android:windowBackground">@drawable/bg_ink_splash</item>
        <!-- Android 12+ draws its own splash first: the same paper and the same small logo. -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/window_paper</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/ic_ink_splash_icon</item>
    </style>

    <style name="Animation.Ink.Activity" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/ink_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/ink_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/ink_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/ink_close_exit</item>
    </style>

    <!-- ===================== Dialogs & sheets ===================== -->
    <style name="CommonDialog" parent="ThemeOverlay.Material3.Dialog">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowAnimationStyle">@style/anim_slide_bottom_in_out</item>
    </style>

    <style name="ThemeOverlay.Ink.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/ink_surface_raised</item>
        <item name="backgroundTint">@color/ink_surface_raised</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Ink.Dialog</item>
        <item name="materialAlertDialogTitleTextStyle">@style/Ink.AlertDialog.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/Ink.AlertDialog.Body</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Ink.Button.Dialog</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Ink.Button.Dialog.Secondary</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Ink.Button.Dialog.Secondary</item>
        <item name="android:backgroundDimAmount">0.28</item>
        <item name="android:windowBlurBehindEnabled" tools:targetApi="31">true</item>
        <item name="android:windowBlurBehindRadius" tools:targetApi="31">@dimen/ink_blur_behind</item>
    </style>

    <style name="ShapeAppearance.Ink.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="Ink.AlertDialog.Title" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">@color/ink_text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Ink.AlertDialog.Body" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textColor">@color/ink_text_secondary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="Widget.Ink.Button.Dialog" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/ink_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Ink.Button.Dialog.Secondary">
        <item name="android:textColor">@color/ink_text_secondary</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="ThemeOverlay.Ink.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Ink.BottomSheet</item>
        <item name="android:navigationBarColor">@color/ink_system_nav_raised</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/ink_light_system_bars</item>
        <item name="android:backgroundDimAmount">0.28</item>
        <item name="android:windowBlurBehindEnabled" tools:targetApi="31">true</item>
        <item name="android:windowBlurBehindRadius" tools:targetApi="31">@dimen/ink_blur_behind</item>
    </style>

    <style name="Widget.Ink.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/ink_surface_raised</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Ink.Sheet</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Ink.Sheet</item>
    </style>

    <style name="ShapeAppearance.Ink.Sheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="ReaderBookshelfRemoveBottomSheetDialog" parent="ThemeOverlay.Ink.BottomSheetDialog" />

    <!--animation-->
    <style name="anim_slide_bottom_in_out" parent="android:Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/slide_bottom_in</item>
        <item name="android:windowExitAnimation">@anim/slide_bottom_out</item>
    </style>

    <style name="anim_slide_left_in_right_out" parent="android:Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/slide_left_in</item>
        <item name="android:windowExitAnimation">@anim/slide_right_out</item>
    </style>

    <!-- ===================== Toolbars & menus ===================== -->
    <style name="Widget.Ink.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">?attr/inkBg</item>
        <item name="navigationIcon">@drawable/ic_ink_back</item>
        <item name="titleTextAppearance">@style/TextAppearance.Ink.Toolbar</item>
        <item name="titleTextColor">@color/ink_text_primary</item>
        <item name="contentInsetStartWithNavigation">0dp</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <style name="Theme.ToolBar.Menu" parent="ThemeOverlay.Material3.Toolbar.Surface">
        <item name="colorControlNormal">@color/ink_text_primary</item>
        <item name="android:textColor">@color/ink_text_primary</item>
        <item name="actionOverflowButtonStyle">@style/ActionButton.Overflow.Menu</item>
        <item name="actionOverflowMenuStyle">@style/OverflowMenuStyle</item>
    </style>

    <style name="Theme.ToolBar.Home" parent="Theme.ToolBar.Menu" />

    <!-- Toolbars on always-dark reader chrome (comic, PDF, EPUB). -->
    <style name="Theme.ToolBar.Reader" parent="ThemeOverlay.Material3.Dark.ActionBar">
        <item name="colorControlNormal">@color/ink_reader_text</item>
        <item name="android:textColor">@color/ink_reader_text</item>
        <item name="actionOverflowButtonStyle">@style/ActionButton.Overflow.Menu</item>
    </style>

    <style name="ActionButton.Overflow.Menu" parent="Widget.AppCompat.ActionButton.Overflow">
        <item name="android:src">@drawable/ic_ink_more</item>
    </style>

    <style name="ActionButton.Overflow.Home" parent="ActionButton.Overflow.Menu" />

    <style name="OverflowMenuStyle" parent="Widget.Material3.PopupMenu.Overflow">
        <item name="overlapAnchor">false</item>
        <item name="android:popupBackground">@drawable/bg_ink_popup</item>
    </style>

    <style name="OverflowMenuStyle.Home" />

    <style name="Widget.Ink.PopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_ink_popup</item>
    </style>

    <style name="dropDownStyle" parent="android:style/Widget.Holo.ListView.DropDown">
        <item name="android:listSelector">@drawable/selector_common_bg</item>
        <item name="android:divider">?attr/inkDivider</item>
        <item name="android:dividerHeight">0dp</item>
    </style>

    <style name="HomeDropDownStyle" parent="dropDownStyle" />

    <!-- ===================== Typography ===================== -->
    <style name="TextAppearance.Ink.Display" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">?attr/inkTitleFont</item>
        <item name="android:textColor">@color/ink_text_primary</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="TextAppearance.Ink.Headline" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">?attr/inkTitleFont</item>
        <item name="android:textColor">@color/ink_text_primary</item>
    </style>

    <style name="TextAppearance.Ink.Toolbar" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink_text_primary</item>
    </style>

    <!-- Reader top bar: the book in serif, the chapter quietly beneath it. -->
    <style name="TextAppearance.Ink.ReaderBarTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">serif</item>
    </style>

    <style name="TextAppearance.Ink.ReaderBarSubtitle" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">11sp</item>
    </style>

    <style name="TextAppearance.Ink.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ink_text_primary</item>
    </style>

    <style name="TextAppearance.Ink.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/ink_text_primary</item>
    </style>

    <style name="TextAppearance.Ink.BodySmall" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ink_text_secondary</item>
    </style>

    <style name="TextAppearance.Ink.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/ink_text_tertiary</item>
    </style>

    <style name="TextAppearance.Ink.Tab" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">15sp</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="TextAppearance.Ink.Section" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ink_text_tertiary</item>
    </style>

    <!-- ===================== Buttons ===================== -->
    <style name="Widget.Ink.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="cornerRadius">24dp</item>
        <item name="backgroundTint">@color/ink_button_filled_bg</item>
        <item name="android:textColor">@color/ink_button_filled_text</item>
        <item name="rippleColor">@color/ink_ripple_on_primary</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@animator/ink_press_scale</item>
    </style>

    <style name="Widget.Ink.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="cornerRadius">24dp</item>
        <item name="backgroundTint">@color/ink_primary_soft</item>
        <item name="android:textColor">@color/ink_primary</item>
        <item name="iconTint">@color/ink_primary</item>
        <item name="rippleColor">@color/ink_ripple</item>
        <item name="android:stateListAnimator">@animator/ink_press_scale</item>
    </style>

    <style name="Widget.Ink.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="cornerRadius">24dp</item>
        <item name="strokeColor">@color/ink_outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/ink_text_primary</item>
        <item name="iconTint">@color/ink_text_primary</item>
        <item name="rippleColor">@color/ink_ripple</item>
    </style>

    <style name="Widget.Ink.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">40dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ink_primary</item>
        <item name="iconTint">@color/ink_primary</item>
        <item name="rippleColor">@color/ink_ripple</item>
    </style>

    <style name="Widget.Ink.Button.Danger" parent="Widget.Ink.Button">
        <item name="backgroundTint">@color/ink_danger</item>
        <item name="android:textColor">@color/ink_on_primary</item>
    </style>

    <style name="Widget.Ink.CheckBox" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="buttonTint">@color/ink_check_tint</item>
    </style>

    <style name="Widget.Ink.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="thumbTint">@color/ink_switch_thumb</item>
        <item name="trackTint">@color/ink_switch_track</item>
        <item name="trackDecorationTint">@color/ink_switch_track_decoration</item>
    </style>

    <style name="Widget.Ink.Chip.Choice" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/ink_chip_bg</item>
        <item name="android:textColor">@color/ink_chip_text</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipCornerRadius">18dp</item>
        <item name="chipMinHeight">36dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:stateListAnimator">@animator/ink_press_scale</item>
        <item name="android:textSize">14sp</item>
        <item name="chipStartPadding">6dp</item>
        <item name="chipEndPadding">6dp</item>
        <item name="rippleColor">@color/ink_ripple</item>
    </style>

    <style name="Widget.Ink.Chip.Action" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/ink_surface_variant</item>
        <item name="android:textColor">@color/ink_text_primary</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipCornerRadius">18dp</item>
        <item name="chipMinHeight">36dp</item>
        <item name="android:textSize">14sp</item>
        <item name="chipStartPadding">6dp</item>
        <item name="chipEndPadding">6dp</item>
        <item name="rippleColor">@color/ink_ripple</item>
    </style>

    <!-- ===================== Common rows & surfaces ===================== -->
    <style name="Ink" />
    <style name="Ink.Divider" />

    <style name="Ink.Card">
        <item name="android:background">@drawable/bg_ink_card</item>
    </style>

    <!-- One settings/list row: 56dp+ touch target, title + optional summary + trailing control. -->
    <style name="Ink.Row">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="Ink.Row.Icon" parent="">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:layout_marginRight">14dp</item>
        <item name="tint">@color/ink_text_secondary</item>
    </style>

    <style name="Ink.Row.Title" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textAppearance">@style/TextAppearance.Ink.Body</item>
    </style>

    <style name="Ink.Row.Summary" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textAppearance">@style/TextAppearance.Ink.Caption</item>
    </style>

    <style name="Ink.Row.Value" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginLeft">12dp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textAppearance">@style/TextAppearance.Ink.BodySmall</item>
        <item name="android:textColor">@color/ink_text_tertiary</item>
    </style>

    <style name="Ink.Row.Chevron" parent="">
        <item name="android:layout_width">18dp</item>
        <item name="android:layout_height">18dp</item>
        <item name="android:layout_marginLeft">4dp</item>
        <item name="android:src">@drawable/ic_ink_chevron_right</item>
        <item name="tint">@color/ink_text_tertiary</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <!-- 题签: the paper title slip pasted on a cloth-bound cover, the title set vertically. -->
    <style name="Ink.BookTitleSlip" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_book_title_slip</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingExtra">1dp</item>
        <item name="android:paddingLeft">4dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingRight">4dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textColor">@color/book_title_slip_ink</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Ink.ThemeSectionLabel" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingLeft">4dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/ink_text_tertiary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- One option of a segmented control on a quiet track. -->
    <style name="Ink.Segment" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_ink_segment_item</item>
        <item name="android:button">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/ink_segment_text</item>
        <item name="android:textSize">14sp</item>
        <item name="useMaterialThemeColors">false</item>
        <item name="buttonTint">@null</item>
    </style>

