<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      墨舟 Ink design tokens.
      Every screen colour resolves to one of these tokens; values-night/colors.xml redefines
      the same names for dark mode, so pages never hard-code a light-only colour.
    -->
    <color name="ink_launcher_background">#1C1B19</color>
    <!-- 朱砂: the one warm accent, used sparingly for marks that need to be noticed. -->
    <!-- Floating glass chrome (bottom bar, popups, reader menus). -->
    <!-- Navigation bar fill. API 25-26 cannot draw dark navigation icons, so it stays dark
         there; values-v27 switches to the page surface. -->
    <color name="ink_system_nav">#141414</color>
    <color name="ink_system_nav_raised">#141414</color>

    <!-- Immersive reader / media chrome. Always dark; content pages use page-style palettes. -->
    <color name="ink_reader_dark">#141414</color>
    <color name="ink_reader_panel">#EB1C1C1B</color>
    <color name="ink_reader_text">#F2F0EB</color>
    <color name="ink_reader_text_muted">#A9A59D</color>
    <color name="ink_reader_line">#33FFFFFF</color>
    <!-- Warm amber wash for the comic reader's eye-care toggle. -->
    <color name="ink_eye_care_tint">#22D8C48A</color>
    <!-- Reader chrome follows the page, not the app theme, so both variants live here. -->
    <color name="ink_reader_ink_light">#1D1C1A</color>
    <color name="ink_reader_ink_dark">#E6E3DD</color>
    <color name="ink_reader_accent_light">#B84A2C</color>
    <color name="ink_reader_accent_dark">#E58466</color>
    <color name="ink_reader_on_accent_light">#FFFFFF</color>
    <color name="ink_reader_on_accent_dark">#1A0F0B</color>

    <!-- Reader page styles: paper, parchment, celadon, mist, indigo night, true night. -->
    <color name="nb.read.bg_1">#F4F0E6</color>
    <color name="nb.read.bg_2">#E7DCC3</color>
    <color name="nb.read.bg_3">#D9E5D3</color>
    <color name="nb.read.bg_4">#E3E2DE</color>
    <color name="nb.read.bg_5">#1A2229</color>
    <color name="nb.read.font_1">#2A2824</color>
    <color name="nb.read.font_2">#3B3226</color>
    <color name="nb.read.font_3">#26332A</color>
    <color name="nb.read.font_4">#2C2C2A</color>
    <color name="nb.read.font_5">#8E9CA6</color>
    <color name="nb.read.bg.night">#101010</color>
    <color name="nb.read.font_night">#8C8983</color>

    <!-- Legacy names kept as aliases so existing pages share the token palette. -->
    <color name="colorPrimary">@color/ink_primary</color>
    <color name="colorPrimaryDark">@color/ink_primary_pressed</color>
    <color name="colorAccent">@color/ink_primary</color>
    <color name="nb.theme.background">@color/ink_surface</color>

    <color name="home_bg">@color/ink_bg</color>
    <color name="mine_bg">@color/ink_bg</color>
    <color name="home_surface">@color/ink_surface</color>
    <color name="home_surface_soft">@color/ink_surface_variant</color>
    <color name="home_primary">@color/ink_primary</color>
    <color name="home_primary_dark">@color/ink_text_primary</color>
    <color name="home_primary_soft">@color/ink_primary_soft</color>
    <color name="home_accent">@color/ink_primary</color>
    <color name="home_text_primary">@color/ink_text_primary</color>
    <color name="home_text_secondary">@color/ink_text_secondary</color>
    <color name="home_text_tertiary">@color/ink_text_tertiary</color>
    <color name="home_text_on_primary">@color/ink_on_primary</color>
    <color name="home_line">@color/ink_divider</color>
    <color name="mine_text_primary">@color/ink_text_primary</color>
    <color name="mine_text_secondary">@color/ink_text_tertiary</color>
    <color name="mine_line">@color/ink_divider</color>
    <color name="home_pressed">@color/ink_surface_pressed</color>
    <color name="home_menu_icon">@color/ink_text_primary</color>
    <color name="home_menu_item">@color/ink_text_primary</color>
    <color name="settings_text_secondary">@color/ink_text_secondary</color>
    <color name="settings_section_label">@color/ink_text_tertiary</color>
    <color name="settings_switch_track_off">@color/ink_outline</color>

    <color name="transparent">#00000000</color>
    <color name="white">#FFFFFF</color>
    <color name="black">#000000</color>
    <color name="light_red">@color/ink_danger</color>
    <color name="chapter_mark_wrong_text">@color/ink_danger</color>
    <color name="chapter_mark_wrong_bg">@color/ink_danger_soft</color>

    <color name="media_bg">@color/ink_bg</color>
    <color name="media_loading_scrim">#E6F7F6F3</color>
    <color name="media_surface">@color/ink_surface</color>
    <color name="media_surface_soft">@color/ink_surface_variant</color>
    <color name="media_line">@color/ink_divider</color>
    <color name="media_text_primary">@color/ink_text_primary</color>
    <color name="media_text_secondary">@color/ink_text_secondary</color>
    <color name="media_text_tertiary">@color/ink_text_tertiary</color>
    <color name="media_comic_accent">@color/ink_primary</color>
    <color name="media_comic_accent_dark">@color/ink_primary_pressed</color>
    <color name="media_audio_accent">@color/ink_primary</color>
    <color name="media_audio_accent_dark">@color/ink_primary_pressed</color>
    <color name="media_audio_player_bg">#1D1915</color>
    <color name="media_audio_player_bg_deep">#0E0C0A</color>
    <color name="media_audio_player_text_primary">#F2F0EB</color>
    <!-- The episode playing, in the player's warm dark: a soft vermilion that stays legible. -->
    <color name="media_audio_player_accent">#E8A27E</color>
    <color name="media_audio_player_text_secondary">#BDB3A6</color>
    <color name="media_audio_player_text_tertiary">#8A8176</color>
    <color name="media_reader_dark">@color/ink_reader_dark</color>
    <!-- A switched-on action on the dark media reader chrome: a soft vermilion. -->
    <color name="media_reader_accent">#E8A27E</color>
    <color name="media_reader_panel">@color/ink_reader_panel</color>
    <color name="media_reader_text">@color/ink_reader_text</color>
    <color name="media_reader_text_muted">@color/ink_reader_text_muted</color>

    <color name="nb.divider.narrow">@color/ink_divider</color>
    <color name="nb.text.default">@color/ink_text_primary</color>
    <color name="nb.text.common_h2">@color/ink_text_secondary</color>
    <color name="nb.read.menu.bg">@color/ink_reader_dark</color>
    <color name="nb.read.menu.text">@color/ink_reader_text</color>
    <!-- PDF page placeholder before render; in dark mode it matches the anti-glare dimmed paper. -->
    <color name="ink_pdf_paper">#FFFFFF</color>
    <!-- Shadow a shelf plank throws on the wall (仿真书架). -->
    <color name="shelf_plank_shadow">#40301C0C</color>
    <!-- Cloth-bound covers for books without one: the slip, its ink and the format label. -->
    <color name="book_title_slip_paper">#F1EADB</color>
    <color name="book_title_slip_edge">#B9A88A</color>
    <color name="book_title_slip_ink">#2B2621</color>
    <color name="book_cloth_label">#B3F1EADB</color>
    <color name="book_cloth_title">#F2F7F2E8</color>
    <!-- Page block of a standing volume (仿真书架), seen at the fore-edge: shaded by the board, lit at the edge. -->
    <color name="book_page_shade">#B8A88B</color>
    <color name="book_page_light">#F2EBDC</color>
    <!--
      Window paint the system draws before the app's theme is applied (launch window, first
      frame): the default theme's paper. Each activity then paints its own theme over it.
    -->
    <color name="window_paper">#F2EDE3</color>
</resources>
